---
import BaseLayout from './BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import CTABand from 'theme/components/CTABand.astro';

export interface Props {
  title: string;
  description: string;
  h1: string;
  heroSubheading?: string;
  serviceType: string;
  priceFrom?: number;
  breadcrumbs?: { name: string; url: string }[];
  faqs?: { question: string; answer: string; display?: boolean }[];
}

const {
  title,
  description,
  h1,
  heroSubheading,
  serviceType,
  priceFrom,
  breadcrumbs = [
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services/' },
    { name: h1, url: Astro.url.pathname }
  ],
  faqs = []
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="service"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  serviceData={{
    name: h1,
    serviceType,
    priceFrom
  }}
>
  <!-- Interactive Modern Hero Section with Quote Form & Floating SVG Tech Badges -->
  <Hero
    variant="service"
    heading={h1}
    subheading={heroSubheading}
    breadcrumbs={breadcrumbs}
    badge={`${serviceType} • 100% Bespoke Code`}
    primaryCtaText="Get a Bespoke Quote"
    primaryCtaHref="/get-a-quote/"
    secondaryCtaText="Explore Pricing"
    secondaryCtaHref="/pricing/"
  />

  <div class="w-full">
    <slot />
  </div>

  <CTABand />
</BaseLayout>
