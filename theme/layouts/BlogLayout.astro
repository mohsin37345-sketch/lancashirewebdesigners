---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import SocialShare from 'theme/components/SocialShare.astro';
import { formatDate } from 'theme/utils/formatDate';
import { calculateReadingTime } from 'theme/utils/readingTime';

export interface Props {
  title: string;
  description: string;
  date: string | Date;
  updatedDate?: string | Date;
  author?: string;
  category?: string;
  image?: string;
  content?: string;
  headings?: { depth: number; slug: string; text: string }[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  date,
  updatedDate,
  author = 'Lancashire Web Designers',
  category = 'Web Design',
  image,
  content = '',
  headings = [],
  breadcrumbs = [
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: title, url: Astro.url.pathname }
  ]
} = Astro.props;

const { text: readingTimeText, words } = calculateReadingTime(content);
---

<BaseLayout
  title={`${title} | Lancashire Web Designers Blog`}
  description={description}
  schemaType="blog-post"
  ogType="article"
  ogImage={image}
  breadcrumbs={breadcrumbs}
  blogData={{
    headline: title,
    description,
    datePublished: date,
    dateModified: updatedDate,
    authorName: author,
    image,
    wordCount: words,
    articleSection: category
  }}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />

      <div class="max-w-4xl">
        <div class="flex items-center gap-3 text-xs font-semibold text-blue-600 dark:text-blue-400 mb-4">
          <span class="px-2.5 py-1 rounded-md bg-blue-50 dark:bg-blue-950/60 uppercase tracking-wider">
            {category}
          </span>
          <span>&bull;</span>
          <span>{readingTimeText}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          {title}
        </h1>

        <div class="mt-6 flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
          <span class="font-medium text-slate-700 dark:text-slate-300">{author}</span>
          <span>&bull;</span>
          <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
          {updatedDate && (
            <span>(Updated: <time datetime={new Date(updatedDate).toISOString()}>{formatDate(updatedDate)}</time>)</span>
          )}
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8 max-w-3xl">
        <article class="prose prose-slate dark:prose-invert prose-lg max-w-none">
          <slot />
        </article>

        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
          <SocialShare title={title} url={Astro.url.href} />
        </div>
      </div>

      {headings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-4">
          <div class="sticky top-28 p-6 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
              Table of Contents
            </h2>
            <ul class="space-y-2 text-sm">
              {headings.filter((h) => h.depth <= 3).map((h) => (
                <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
                  <a
                    href={`#${h.slug}`}
                    class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors block py-0.5"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
