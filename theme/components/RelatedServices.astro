---
import Icon from './Icon.astro';

export interface RelatedServiceItem {
  title: string;
  href: string;
  description: string;
  icon?: string;
}

export interface Props {
  services: RelatedServiceItem[];
  heading?: string;
  subheading?: string;
  class?: string;
}

const {
  services = [],
  heading = 'Explore Related Services',
  subheading = 'Strategic digital solutions engineered to accelerate your online performance.',
  class: className = ''
} = Astro.props;

if (!services || services.length === 0) {
  return null;
}
---

<section class={`py-16 lg:py-20 bg-slate-50/50 dark:bg-slate-900/30 border-t border-slate-200 dark:border-slate-800 ${className}`}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
        Connected Capabilities
      </span>
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
        {heading}
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.slice(0, 3).map((item) => (
        <a
          href={item.href}
          class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-blue-500/50 rounded-3xl p-7 flex flex-col justify-between shadow-2xs hover:shadow-lg transition-all hover-lift"
        >
          <div class="space-y-4">
            <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <Icon name={item.icon || 'arrow-right'} class="w-5 h-5" />
            </div>

            <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {item.description}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2 text-xs font-bold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">
            <span>Learn More</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
