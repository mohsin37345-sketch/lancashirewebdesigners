---
import Icon from './Icon.astro';

export interface PortfolioShowcaseItem {
  title: string;
  client: string;
  industry: string;
  year?: number;
  href: string;
  brief: string;
  metrics?: { label: string; value: string; note?: string }[];
  image?: string;
}

export interface Props {
  heading?: string;
  subheading?: string;
  items: PortfolioShowcaseItem[];
  viewAllHref?: string;
  class?: string;
}

const {
  heading = 'Recent Client Projects & Case Studies',
  subheading = 'Real commercial projects delivered with hand-crafted code and measurable business outcomes.',
  items = [],
  viewAllHref = '/portfolio/',
  class: className = ''
} = Astro.props;

if (!items || items.length === 0) {
  return null;
}
---

<section class={`space-y-8 ${className}`}>
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
        Proven Work
      </span>
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
        {heading}
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm leading-relaxed">
        {subheading}
      </p>
    </div>

    {viewAllHref && (
      <a
        href={viewAllHref}
        class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-colors self-start sm:self-auto shrink-0"
      >
        <span>View Full Portfolio</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    )}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {items.map((item) => (
      <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-7 flex flex-col justify-between shadow-2xs hover:border-blue-500/40 hover:shadow-lg transition-all group">
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-semibold text-blue-600 dark:text-blue-400">
            <span>{item.client}</span>
            <span class="text-slate-400 dark:text-slate-500">{item.industry}</span>
          </div>

          <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
            <a href={item.href}>
              {item.title}
            </a>
          </h3>

          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
            {item.brief}
          </p>

          {item.metrics && item.metrics.length > 0 && (
            <div class="grid grid-cols-2 gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
              {item.metrics.slice(0, 2).map((m) => (
                <div class="bg-slate-50 dark:bg-slate-800/60 p-2.5 rounded-xl">
                  <div class="text-[11px] font-medium text-slate-500 dark:text-slate-400">{m.label}</div>
                  <div class="text-xs font-bold text-slate-900 dark:text-white truncate">{m.value}</div>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-800">
          <a
            href={item.href}
            class="inline-flex items-center gap-2 text-xs font-bold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform"
          >
            <span>Read Case Study</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
