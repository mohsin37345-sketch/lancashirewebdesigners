---
import { site } from 'src/data/site';
import Icon from './Icon.astro';

export interface PricingTier {
  name: string;
  priceFrom: string;
  qualifyingCondition: string;
  description: string;
  popular?: boolean;
  features: string[];
  ctaText: string;
  ctaHref: string;
}

const defaultTiers: PricingTier[] = [
  {
    name: 'Bespoke Brochure Site',
    priceFrom: site.pricing.brochureFrom,
    qualifyingCondition: 'Standard 1–5 page bespoke architecture. Extra pages easily added at +£25/page.',
    description: 'Perfect for established local service providers, professional consultancies, and trades.',
    popular: false,
    features: [
      'Bespoke visual design (Figma prototype)',
      'Hand-crafted semantic HTML5 & Tailwind build',
      '95+ Core Web Vitals performance score',
      'Local schema graph & SEO architecture',
      'Fast contact & quote enquiry forms',
      'Extra pages can be added at +£25/page',
      '100% intellectual property ownership'
    ],
    ctaText: 'Enquire About Brochure Site',
    ctaHref: '/get-a-quote/'
  },
  {
    name: 'B2B Growth & Lead Platform',
    priceFrom: site.pricing.b2bFrom,
    qualifyingCondition: 'Core B2B lead generation architecture. Expandable page modules at +£25/page.',
    description: 'Engineered for B2B firms, industrial manufacturers, and high-value professional practices.',
    popular: true,
    features: [
      'Everything in Brochure Site',
      'Interactive lead qualification flow',
      'CRM & webhook email integration',
      'Keyword cluster mapping & technical SEO',
      'Flexible page expansions (+£25/page)',
      'Full WCAG 2.2 AA accessibility audit'
    ],
    ctaText: 'Build Your B2B Engine',
    ctaHref: '/get-a-quote/'
  },
  {
    name: 'Bespoke Ecommerce Build',
    priceFrom: site.pricing.ecommerceFrom,
    qualifyingCondition: 'Complete online storefront setup with payment gateways (Stripe/Apple Pay/Shopify).',
    description: 'High-conversion, lightning-fast Shopify or bespoke store tailored for transactional revenue.',
    popular: false,
    features: [
      'Custom bespoke theme development',
      'Sub-second cart & checkout workflows',
      'Product catalogue and variant setup',
      'Shipping rule configuration & taxes',
      'Transactional email styling',
      'Extra pages or products (+£25/page)',
      'Full staff handover documentation'
    ],
    ctaText: 'Discuss Ecommerce Scope',
    ctaHref: '/get-a-quote/'
  }
];

export interface Props {
  tiers?: PricingTier[];
  class?: string;
}

const { tiers = defaultTiers, class: className = '' } = Astro.props;
---

<section class={`py-16 lg:py-24 ${className}`}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
        Honest Investment
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
        Transparent, Fixed-Price Web Packages
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-3 text-base">
        No unexpected invoices. Every project is scoped to a fixed price with clear milestones. Need more pages? Add extra custom pages to any package for just +£50/page.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {tiers.map((tier) => (
        <div
          class={`relative rounded-3xl p-8 flex flex-col justify-between transition-lift shadow-sm ${
            tier.popular
              ? 'bg-white dark:bg-slate-900 border-2 border-blue-600 shadow-xl ring-4 ring-blue-600/10'
              : 'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800'
          }`}
        >
          {tier.popular && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-[11px] font-extrabold uppercase tracking-wider py-1 px-3.5 rounded-full shadow-md">
              Most Popular
            </div>
          )}

          <div class="space-y-6">
            <div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
                {tier.name}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                {tier.description}
              </p>
            </div>

            <!-- Price and immediate qualifying condition (Advertising Standards compliant) -->
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
              <div class="flex items-baseline gap-1">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">From</span>
                <span class="text-3xl font-black text-slate-900 dark:text-white">{tier.priceFrom}</span>
                <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">+ VAT</span>
              </div>
              <div class="mt-2 text-[11px] text-slate-500 dark:text-slate-400 leading-snug border-t border-slate-200/60 dark:border-slate-700/60 pt-2">
                <strong class="text-slate-700 dark:text-slate-300">Qualifying scope:</strong> {tier.qualifyingCondition}
              </div>
            </div>

            <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-300">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="check" class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-8 mt-8 border-t border-slate-100 dark:border-slate-800/80">
            <a
              href={tier.ctaHref}
              class={`w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl text-sm font-bold transition-all duration-150 ${
                tier.popular
                  ? 'bg-blue-600 hover:bg-blue-700 text-white shadow-md'
                  : 'bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200'
              }`}
            >
              <span>{tier.ctaText}</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
