---
import Icon from './Icon.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-10 shadow-sm ${className}`}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
    <!-- Left: Interactive Configuration Controls -->
    <div class="lg:col-span-7 space-y-8">
      <div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
          Configure Your Project Parameters
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Adjust page volume, functional requirements, and asset readiness for an instant indicative estimate.
        </p>
      </div>

      <!-- 1. Scope / Page Count -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            1. Website Scope & Approximate Page Count
          </label>
          <span class="text-[11px] font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded-full border border-blue-200 dark:border-blue-900">
            +£20–£30 per extra page
          </span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          {[
            { label: '1–5 Pages', val: 'small', price: 150, desc: 'Starter / Bespoke' },
            { label: '6–10 Pages', val: 'standard', price: 250, desc: 'Corporate / B2B' },
            { label: '11–20 Pages', val: 'medium', price: 400, desc: 'Multi-Service' },
            { label: '20+ Pages', val: 'large', price: 600, desc: 'Extensive Site' }
          ].map((item, idx) => (
            <label class="calc-scope-card flex flex-col p-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 cursor-pointer text-center hover:border-blue-400 transition-all">
              <input type="radio" name="calc_scope" value={item.val} data-price={item.price} checked={idx === 0} class="hidden" />
              <span class="text-sm font-bold text-slate-900 dark:text-white">{item.label}</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">{item.desc}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- 2. Commercial Features Needed -->
      <div class="space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          2. Required Functionality & Integrations
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {[
            { label: 'Ecommerce Storefront (Shopify / Stripe)', price: 150, id: 'feat-ecom' },
            { label: 'Web Design & Marketing / SEO Package', price: 150, id: 'feat-marketing' },
            { label: 'WordPress CMS & Custom Gutenberg', price: 100, id: 'feat-wordpress' },
            { label: 'Website Speed & Core Web Vitals Optimisation', price: 75, id: 'feat-speed' },
            { label: 'Technical SEO Audit & Schema Graph', price: 50, id: 'feat-seo' },
            { label: 'Dedicated Campaign Landing Page', price: 75, id: 'feat-landing' }
          ].map((item) => (
            <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-800/30 text-xs font-semibold text-slate-700 dark:text-slate-300 cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800">
              <div class="flex items-center gap-2">
                <input type="checkbox" name="calc_features" data-price={item.price} class="calc-feature-checkbox rounded text-blue-600 focus:ring-blue-500" />
                <span>{item.label}</span>
              </div>
              <span class="text-slate-400 font-mono text-[11px]">+£{item.price}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- 3. Content Readiness -->
      <div class="space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          3. Content & Asset Readiness
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
          {[
            { label: 'Ready & Approved', val: 'ready', price: 0, desc: 'Client supplies all copy & media' },
            { label: 'Partial Support', val: 'partial', price: 75, desc: 'We edit & refine copy + curate imagery' },
            { label: 'Full Studio Copywriting', val: 'full', price: 150, desc: 'We research & write all text from scratch' }
          ].map((item, idx) => (
            <label class="calc-content-card flex flex-col p-3 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 cursor-pointer hover:border-blue-400 transition-all text-center">
              <input type="radio" name="calc_content" value={item.val} data-price={item.price} checked={idx === 0} class="hidden" />
              <span class="text-xs font-bold text-slate-900 dark:text-white">{item.label}</span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">{item.desc}</span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: Sticky Live Price Bracket -->
    <div class="lg:col-span-5">
      <div class="sticky top-28 bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl space-y-6">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-blue-400 bg-blue-950/80 px-2.5 py-1 rounded-md border border-blue-900">
            Real-Time Estimate
          </span>
          <h4 class="text-lg font-bold text-white mt-3">
            Indicative Investment Bracket
          </h4>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">
            Calculated against our transparent UK engineering rates. No surprise markups.
          </p>
        </div>

        <div class="py-6 border-y border-slate-800 space-y-2 text-center bg-slate-950/50 rounded-2xl p-4">
          <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Estimated Range (ex VAT)</div>
          <div id="calc-result-range" class="text-3xl sm:text-4xl font-black text-white font-mono tracking-tight text-blue-400">
            £300 – £400
          </div>
          <div class="text-[11px] text-slate-400">
            Includes custom Figma prototype, bespoke coding, and full IP handover.
          </div>
        </div>

        <div class="space-y-3 text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>100% bespoke code — zero builder lock-in</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Sub-second load times & 95+ Core Web Vitals</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>30-day post-launch warranty included</span>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="/get-a-quote/"
            id="calc-cta-btn"
            class="w-full inline-flex items-center justify-center gap-2 py-4 px-6 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-md transition-all hover-lift"
          >
            <span>Lock In This Scope & Quote</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <p class="text-[11px] text-slate-500 text-center">
          Note: Final fixed quotation requires a brief technical discovery conversation to confirm bespoke APIs and integrations.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const scopeRadios = document.querySelectorAll('input[name="calc_scope"]');
    const featureCheckboxes = document.querySelectorAll('.calc-feature-checkbox');
    const contentRadios = document.querySelectorAll('input[name="calc_content"]');
    const resultRange = document.getElementById('calc-result-range');

    function calculate() {
      let base = 150;
      scopeRadios.forEach((r) => {
        if (r.checked) {
          base = parseInt(r.getAttribute('data-price') || '150', 10);
        }
      });

      let featuresTotal = 0;
      featureCheckboxes.forEach((cb) => {
        if (cb.checked) {
          featuresTotal += parseInt(cb.getAttribute('data-price') || '0', 10);
        }
      });

      let contentTotal = 0;
      contentRadios.forEach((r) => {
        if (r.checked) {
          contentTotal = parseInt(r.getAttribute('data-price') || '0', 10);
        }
      });

      const totalLower = base + featuresTotal + contentTotal;
      const totalUpper = Math.round(totalLower * 1.25 / 10) * 10;

      if (resultRange) {
        resultRange.textContent = `£${totalLower.toLocaleString('en-GB')} – £${totalUpper.toLocaleString('en-GB')}`;
      }

      // Update card visual active states
      document.querySelectorAll('.calc-scope-card').forEach((card) => {
        const input = card.querySelector('input');
        if (input && input.checked) {
          card.classList.add('border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/40');
        } else {
          card.classList.remove('border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/40');
        }
      });

      document.querySelectorAll('.calc-content-card').forEach((card) => {
        const input = card.querySelector('input');
        if (input && input.checked) {
          card.classList.add('border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/40');
        } else {
          card.classList.remove('border-blue-600', 'bg-blue-50/50', 'dark:bg-blue-950/40');
        }
      });
    }

    scopeRadios.forEach((r) => r.addEventListener('change', calculate));
    featureCheckboxes.forEach((c) => c.addEventListener('change', calculate));
    contentRadios.forEach((r) => r.addEventListener('change', calculate));

    calculate();
  })();
</script>
