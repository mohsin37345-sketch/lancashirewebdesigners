---
import { site } from 'src/data/site';
import { absoluteUrl } from 'theme/utils/absoluteUrl';
import verificationData from 'src/data/verification.json';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title = `${site.name} | Bespoke Web Design & Development`,
  description = 'Bespoke, high-performance web design and development for ambitious Lancashire businesses. Fast, secure, and built from scratch to convert.',
  canonical,
  noindex = false,
  nofollow = false,
  ogType = 'website',
  ogImage = '/assets/og-default.jpg',
  ogImageAlt = `${site.name} — Bespoke Web Design Studio in Lancashire`,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor
} = Astro.props;

// Ensure trailing slash on canonical
const rawPath = Astro.url.pathname;
const resolvedCanonical = canonical || absoluteUrl(rawPath);
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);

// Robots directive
const robotsContent = `${noindex ? 'noindex' : 'index'}, ${nofollow ? 'nofollow' : 'follow'}`;

// Verification codes
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || verificationData.google;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION || verificationData.bing;
---

<!-- Character & Viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

<!-- Title & Meta Description -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />

<!-- Robots -->
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

<!-- Search Engine Verification -->
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

<!-- Theme Color for light and dark modes -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#070b14" media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleModifiedTime && (
  <meta property="article:modified_time" content={articleModifiedTime} />
)}
{ogType === 'article' && articleAuthor && (
  <meta property="article:author" content={articleAuthor} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Favicon & App Manifest -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Font preload (Plus Jakarta Sans Latin variable) -->
<link
  rel="preload"
  href="/@fs/node_modules/@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Inline Dark Mode Blocking Script (Zero Flash of Incorrect Theme) -->
<script is:inline>
  (function () {
    try {
      const stored = localStorage.getItem('lwd-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const isDark = stored === 'dark' || (!stored && prefersDark);
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = 'dark';
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.style.colorScheme = 'light';
      }
    } catch (e) {
      // Fallback
    }
  })();
</script>
