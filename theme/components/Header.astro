---
import { site } from 'src/data/site';
import navData from 'src/data/navigation.json';
import Icon from './Icon.astro';

const mainNav = navData.mainNav;
const phone = site.phoneDisplay || site.phone;
const phoneHref = site.phoneE164 ? `tel:${site.phoneE164}` : undefined;
---

<header id="site-header" class="sticky top-0 z-50 w-full glass-header transition-all duration-200">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center focus-visible:ring-2 focus-visible:ring-blue-600 rounded-md p-1 group" aria-label="Lancashire Web Designers Home">
      <img
        src="/images/logo.webp"
        alt="Lancashire Web Designers"
        width="220"
        height="58"
        class="h-10 sm:h-11 w-auto object-contain block dark:hidden group-hover:opacity-90 transition-opacity"
        loading="eager"
        decoding="async"
      />
      <img
        src="/images/logo-dark.webp"
        alt="Lancashire Web Designers"
        width="220"
        height="58"
        class="h-10 sm:h-11 w-auto object-contain hidden dark:block group-hover:opacity-90 transition-opacity"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
      {mainNav.map((item) => {
        const hasMegaMenu = !!item.megaMenu;
        return (
          <div class="relative group">
            {hasMegaMenu ? (
              <button
                type="button"
                class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg hover:bg-slate-100/60 dark:hover:bg-slate-800/60 transition-colors focus-visible:ring-2 focus-visible:ring-blue-600"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>{item.label}</span>
                <Icon name="chevron-down" class="w-4 h-4 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" />
              </button>
            ) : (
              <a
                href={item.href}
                class="px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-lg hover:bg-slate-100/60 dark:hover:bg-slate-800/60 transition-colors focus-visible:ring-2 focus-visible:ring-blue-600"
              >
                {item.label}
              </a>
            )}

            {/* Mega Menu Dropdown */}
            {hasMegaMenu && item.megaMenu && (
              <div class="absolute left-0 top-full pt-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
                <div class="w-[620px] bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 p-6 grid grid-cols-2 gap-6">
                  {item.megaMenu.groups.map((group) => (
                    <div>
                      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3 px-2">
                        {group.title}
                      </h3>
                      <ul class="space-y-1">
                        {group.items.map((subItem) => (
                          <li>
                            <a
                              href={subItem.href}
                              class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/80 transition-colors group/item focus-visible:ring-2 focus-visible:ring-blue-600"
                            >
                              <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                                <Icon name={subItem.icon || 'code'} class="w-4 h-4" />
                              </div>
                              <div>
                                <div class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover/item:text-blue-600 dark:group-hover/item:text-blue-400 transition-colors">
                                  {subItem.label}
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">
                                  {subItem.description}
                                </div>
                              </div>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Header Actions: Dark Mode + Get a Quote + Mobile Toggle -->
    <div class="flex items-center gap-3">
      {/* Dark Mode Toggle */}
      <button
        id="theme-toggle-btn"
        type="button"
        class="w-10 h-10 rounded-xl flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-600"
        aria-label="Toggle light or dark theme"
      >
        <span class="dark:hidden">
          <Icon name="moon" class="w-5 h-5" />
        </span>
        <span class="hidden dark:inline">
          <Icon name="sun" class="w-5 h-5" />
        </span>
      </button>

      {/* Primary CTA */}
      <a
        href="/get-a-quote/"
        class="hidden sm:inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-sm transition-all duration-150 hover-lift focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"
      >
        <span>Get a Quote</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>

      {/* Mobile Menu Trigger Button */}
      <button
        id="mobile-menu-trigger"
        type="button"
        class="lg:hidden w-10 h-10 rounded-xl flex items-center justify-center text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus-visible:ring-2 focus-visible:ring-blue-600"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Open mobile navigation menu"
      >
        <span id="menu-icon-open">
          <Icon name="menu" class="w-6 h-6" />
        </span>
        <span id="menu-icon-close" class="hidden">
          <Icon name="close" class="w-6 h-6" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay & Panel -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-200 lg:hidden"
    aria-hidden="true"
  ></div>

  <div
    id="mobile-menu-drawer"
    class="fixed top-20 right-0 bottom-0 w-full max-w-sm bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl z-50 transform translate-x-full transition-transform duration-200 ease-in-out flex flex-col justify-between overflow-y-auto lg:hidden"
    aria-hidden="true"
    role="dialog"
    aria-label="Mobile Navigation"
  >
    <div class="p-6 space-y-6">
      <nav class="space-y-1" aria-label="Mobile Menu Links">
        {mainNav.map((item) => (
          <div>
            <a
              href={item.href}
              class="mobile-nav-link block px-4 py-3 text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-colors"
            >
              {item.label}
            </a>
            {item.megaMenu && (
              <div class="pl-4 space-y-1 mt-1 border-l-2 border-slate-100 dark:border-slate-800">
                {item.megaMenu.groups.flatMap((g) => g.items).slice(0, 4).map((subItem) => (
                  <a
                    href={subItem.href}
                    class="mobile-nav-link block px-3 py-2 text-sm text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400"
                  >
                    {subItem.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>
    </div>

    <!-- Mobile Drawer Footer CTA -->
    <div class="p-6 border-t border-slate-100 dark:border-slate-800 space-y-3 bg-slate-50/50 dark:bg-slate-950/50">
      {phoneHref && phone && (
        <a
          href={phoneHref}
          class="mobile-nav-link flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-sm"
        >
          <Icon name="phone" class="w-4 h-4 text-blue-600" />
          <span>{phone}</span>
        </a>
      )}
      {site.email && (
        <a
          href={`mailto:${site.email}`}
          class="mobile-nav-link flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 font-medium text-xs hover:text-blue-600 transition-colors"
        >
          <Icon name="mail" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
          <span>{site.email}</span>
        </a>
      )}
      <a
        href="/get-a-quote/"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-blue-600 text-white font-semibold text-sm shadow-md hover:bg-blue-700"
      >
        <span>Get a Quote</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</header>

<!-- Header & Mobile Drawer Client Controller -->
<script is:inline>
  (function () {
    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-menu-drawer');
    const overlay = document.getElementById('mobile-menu-overlay');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const themeBtn = document.getElementById('theme-toggle-btn');
    const links = document.querySelectorAll('.mobile-nav-link');

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      trigger?.setAttribute('aria-expanded', 'true');
      trigger?.setAttribute('aria-label', 'Close mobile navigation menu');
      drawer?.setAttribute('aria-hidden', 'false');
      overlay?.setAttribute('aria-hidden', 'false');

      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');

      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
      drawer?.classList.remove('translate-x-full');

      document.body.style.overflow = 'hidden';

      // Focus trap
      const focusables = drawer?.querySelectorAll('a, button, input');
      if (focusables && focusables.length > 0) {
        (focusables[0]).focus();
      }
    }

    function closeMenu() {
      isOpen = false;
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.setAttribute('aria-label', 'Open mobile navigation menu');
      drawer?.setAttribute('aria-hidden', 'true');
      overlay?.setAttribute('aria-hidden', 'true');

      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');

      drawer?.classList.add('translate-x-full');
      overlay?.classList.add('opacity-0');
      setTimeout(() => overlay?.classList.add('hidden'), 200);

      document.body.style.overflow = '';
      trigger?.focus();
    }

    trigger?.addEventListener('click', () => {
      if (isOpen) closeMenu();
      else openMenu();
    });

    overlay?.addEventListener('click', closeMenu);

    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Escape key handling
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Dark Mode Toggle
    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.style.colorScheme = 'light';
        localStorage.setItem('lwd-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = 'dark';
        localStorage.setItem('lwd-theme', 'dark');
      }
    });
  })();
</script>
