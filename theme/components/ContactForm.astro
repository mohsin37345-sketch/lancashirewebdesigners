---
import Icon from './Icon.astro';
import { site } from 'src/data/site';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const formAccessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY || '';
const recipientEmail = site.email;
---

<div class={`bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm ${className}`}>
  <form id="contact-form" class="space-y-6" novalidate data-email={recipientEmail}>
    <input type="hidden" name="access_key" value={formAccessKey} />
    <!-- Anti-spam Honeypot -->
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

    <div class="space-y-4">
      <!-- Name Field -->
      <div>
        <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Your Name <span class="text-blue-600 dark:text-blue-400">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          autocomplete="name"
          placeholder="e.g. David Harrison"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 text-slate-900 dark:text-white placeholder-slate-400 focus-visible:ring-2 focus-visible:ring-blue-600 text-sm transition-colors"
          aria-describedby="name-error"
        />
        <span id="name-error" class="hidden text-xs text-rose-600 mt-1" role="alert">Please enter your name.</span>
      </div>

      <!-- Email Field -->
      <div>
        <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Business Email <span class="text-blue-600 dark:text-blue-400">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          autocomplete="email"
          placeholder="david@company.co.uk"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 text-slate-900 dark:text-white placeholder-slate-400 focus-visible:ring-2 focus-visible:ring-blue-600 text-sm transition-colors"
          aria-describedby="email-error"
        />
        <span id="email-error" class="hidden text-xs text-rose-600 mt-1" role="alert">Please enter a valid email address.</span>
      </div>

      <!-- Phone Field (Optional) -->
      <div>
        <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Phone Number <span class="text-slate-400 font-normal">(Optional)</span>
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          autocomplete="tel"
          placeholder="e.g. 01254 000000"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 text-slate-900 dark:text-white placeholder-slate-400 focus-visible:ring-2 focus-visible:ring-blue-600 text-sm transition-colors"
        />
      </div>

      <!-- Message Field -->
      <div>
        <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1.5">
          Project Brief / Message <span class="text-blue-600 dark:text-blue-400">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          placeholder="Tell us about your project, current website, timeline, and commercial goals..."
          class="w-full px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 text-slate-900 dark:text-white placeholder-slate-400 focus-visible:ring-2 focus-visible:ring-blue-600 text-sm transition-colors"
          aria-describedby="message-error"
        ></textarea>
        <span id="message-error" class="hidden text-xs text-rose-600 mt-1" role="alert">Please provide details regarding your enquiry.</span>
      </div>
    </div>

    <!-- Status feedback banner -->
    <div id="form-status" class="hidden p-4 rounded-xl text-sm font-medium" role="status" aria-live="polite"></div>

    <!-- Submit Button -->
    <button
      type="submit"
      id="submit-btn"
      class="w-full inline-flex items-center justify-center gap-2 py-4 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition-all hover-lift focus-visible:ring-2 focus-visible:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed"
    >
      <span id="btn-text">Send Direct Enquiry</span>
      <Icon name="arrow-right" class="w-4 h-4" />
    </button>

    <!-- Direct mailto fallback -->
    <p class="text-center text-xs text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800">
      Prefer direct email? Send your project brief directly to <a href={`mailto:${recipientEmail}`} class="text-blue-600 dark:text-blue-400 hover:underline font-semibold">{recipientEmail}</a>.
    </p>
  </form>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById('contact-form');
    const statusDiv = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');

    if (!form || !statusDiv || !submitBtn || !btnText) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Basic client-side validation
      const nameInput = document.getElementById('contact-name');
      const emailInput = document.getElementById('contact-email');
      const messageInput = document.getElementById('contact-message');
      const nameError = document.getElementById('name-error');
      const emailError = document.getElementById('email-error');
      const messageError = document.getElementById('message-error');

      let isValid = true;

      if (!nameInput.value.trim()) {
        nameError.classList.remove('hidden');
        nameInput.setAttribute('aria-invalid', 'true');
        isValid = false;
      } else {
        nameError.classList.add('hidden');
        nameInput.removeAttribute('aria-invalid');
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailInput.value.trim())) {
        emailError.classList.remove('hidden');
        emailInput.setAttribute('aria-invalid', 'true');
        isValid = false;
      } else {
        emailError.classList.add('hidden');
        emailInput.removeAttribute('aria-invalid');
      }

      if (!messageInput.value.trim()) {
        messageError.classList.remove('hidden');
        messageInput.setAttribute('aria-invalid', 'true');
        isValid = false;
      } else {
        messageError.classList.add('hidden');
        messageInput.removeAttribute('aria-invalid');
      }

      if (!isValid) return;

      // Set Sending state
      submitBtn.disabled = true;
      btnText.textContent = 'Sending Enquiry...';
      statusDiv.className = 'p-4 rounded-xl text-sm font-medium bg-blue-50 dark:bg-blue-950/60 text-blue-800 dark:text-blue-200 border border-blue-200 dark:border-blue-800';
      statusDiv.textContent = 'Transmitting your brief to our development team...';
      statusDiv.classList.remove('hidden');

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.ok && data.success) {
          // Success state -> redirect to /thank-you/
          window.location.href = '/thank-you/';
        } else {
          // API error
          throw new Error(data.message || 'API submission returned non-success response.');
        }
      } catch (err) {
        submitBtn.disabled = false;
        btnText.textContent = 'Retry Sending Enquiry';
        statusDiv.className = 'p-4 rounded-xl text-sm font-medium bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-200 border border-rose-200 dark:border-rose-800';
        const fallbackEmail = form.getAttribute('data-email');
        if (fallbackEmail) {
          statusDiv.innerHTML = `Unable to send via automated gateway. Please email us directly at <a href="mailto:${fallbackEmail}" class="underline font-bold">${fallbackEmail}</a>.`;
        } else {
          statusDiv.textContent = 'Unable to send via automated gateway. Please verify your connection or try again shortly.';
        }
      }
    });
  })();
</script>
