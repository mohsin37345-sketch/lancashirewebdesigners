---
import Icon from './Icon.astro';
import { formatDate } from 'theme/utils/formatDate';

export interface Props {
  title: string;
  description: string;
  href: string;
  date: string | Date;
  category: string;
  author?: string;
  image?: string;
  readingTime?: string;
}

const {
  title,
  description,
  href,
  date,
  category,
  author,
  image,
  readingTime
} = Astro.props;
---

<article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between transition-lift hover-lift shadow-sm group">
  {image && (
    <div class="aspect-video w-full bg-slate-100 dark:bg-slate-800 overflow-hidden relative">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="p-6 lg:p-7 space-y-3">
    <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400">
      <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 uppercase tracking-wider">
        {category}
      </span>
      {readingTime && (
        <>
          <span>&bull;</span>
          <span class="text-slate-500 dark:text-slate-400">{readingTime}</span>
        </>
      )}
    </div>

    <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
      <a href={href} class="focus-visible:ring-2 focus-visible:ring-blue-600 rounded">
        {title}
      </a>
    </h3>

    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>

  <div class="p-6 pt-0 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
    <div class="flex items-center gap-1.5">
      {author && <span>{author} &bull;</span>}
      <time datetime={new Date(date).toISOString()}>{formatDate(date)}</time>
    </div>
    <span class="text-blue-600 dark:text-blue-400 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
      Read Article
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </span>
  </div>
</article>
