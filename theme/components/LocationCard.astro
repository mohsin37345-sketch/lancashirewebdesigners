---
import Icon from './Icon.astro';

export interface Props {
  town: string;
  href: string;
  county?: string;
  description: string;
  postcodes?: string[];
}

const {
  town,
  href,
  county = 'Lancashire',
  description,
  postcodes = []
} = Astro.props;
---

<article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 flex flex-col justify-between transition-lift hover-lift shadow-sm group">
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
        <Icon name="map-pin" class="w-5 h-5" />
      </div>
      <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
        {county}
      </span>
    </div>

    <h3 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
      <a href={href} class="focus-visible:ring-2 focus-visible:ring-blue-600 rounded">
        Web Design {town}
      </a>
    </h3>

    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
      {description}
    </p>

    {postcodes.length > 0 && (
      <div class="pt-2 text-xs text-slate-500 dark:text-slate-500">
        Districts: {postcodes.join(', ')}
      </div>
    )}
  </div>

  <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
    <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Local Developer</span>
    <a
      href={href}
      class="text-xs font-bold text-blue-600 dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform"
      aria-label={`View web design services in ${town}`}
    >
      <span>View Services</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>
</article>
