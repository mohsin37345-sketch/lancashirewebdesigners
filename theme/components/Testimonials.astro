---
import Icon from './Icon.astro';
import rawTestimonials from 'src/data/testimonials.json';

export interface Testimonial {
  name: string;
  company: string;
  town: string;
  service: string;
  rating: number;
  date: string | Date;
  body: string;
  source?: string;
  verified: boolean;
}

export interface Props {
  testimonials?: Testimonial[];
  serviceTag?: string;
  heading?: string;
  subheading?: string;
  class?: string;
}

const {
  testimonials: propTestimonials,
  serviceTag,
  heading = 'Trusted by Lancashire Business Owners',
  subheading = 'Verified feedback from genuine clients across Blackburn, Preston, Lancaster, and beyond.',
  class: className = ''
} = Astro.props;

// Use props if provided, otherwise pull from shared testimonials data file
const sourceList: Testimonial[] = (propTestimonials && propTestimonials.length > 0)
  ? propTestimonials
  : (rawTestimonials as Testimonial[]);

// Filter strictly for verified testimonials, optionally by service tag
const verifiedItems = sourceList
  .filter((t) => t.verified === true)
  .filter((t) => (!serviceTag ? true : t.service?.toLowerCase().includes(serviceTag.toLowerCase())));
---

{verifiedItems.length > 0 ? (
  <section class={`py-16 lg:py-24 bg-slate-50/70 dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800 ${className}`}>
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          Client Feedback
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {heading}
        </h2>
        <p class="text-slate-600 dark:text-slate-400 mt-3 text-base">
          {subheading}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {verifiedItems.map((item) => (
          <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-7 flex flex-col justify-between shadow-2xs">
            <div class="space-y-4">
              <!-- Star rating -->
              <div class="flex items-center gap-1 text-amber-500">
                {Array.from({ length: 5 }).map((_, i) => (
                  <Icon
                    name="star"
                    class={`w-4 h-4 ${i < item.rating ? 'text-amber-500' : 'text-slate-200 dark:text-slate-700'}`}
                  />
                ))}
              </div>

              <blockquote class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed italic">
                &ldquo;{item.body}&rdquo;
              </blockquote>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">
                  {item.name}
                </div>
                <div class="text-xs text-slate-500 dark:text-slate-400">
                  {item.company} &bull; {item.town}
                </div>
              </div>
              <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800">
                Verified Client
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
) : (
  <Fragment set:html="<!-- TODO(Mohsin): add real case study/testimonial -->" />
)}
