---
import Icon from './Icon.astro';

export interface AreaTown {
  name: string;
  href: string;
  tier: 1 | 2 | 3;
  postcodes?: string;
}

const towns: AreaTown[] = [
  { name: 'Blackburn', href: '/areas/web-design-blackburn/', tier: 1, postcodes: 'BB1, BB2' },
  { name: 'Preston', href: '/areas/web-design-preston/', tier: 1, postcodes: 'PR1, PR2' },
  { name: 'Lancaster', href: '/areas/web-design-lancaster/', tier: 1, postcodes: 'LA1, LA2' },
  { name: 'Burnley', href: '/areas/', tier: 2, postcodes: 'BB10, BB11' },
  { name: 'Blackpool', href: '/areas/', tier: 2, postcodes: 'FY1, FY2' },
  { name: 'Accrington', href: '/areas/', tier: 2, postcodes: 'BB5' },
  { name: 'Chorley', href: '/areas/', tier: 2, postcodes: 'PR6, PR7' },
  { name: 'Darwen', href: '/areas/', tier: 2, postcodes: 'BB3' }
];
---

<section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 lg:p-10 shadow-sm">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Left: Coverage Info & Town Links -->
    <div class="lg:col-span-6 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400">
        <Icon name="map-pin" class="w-3.5 h-3.5" />
        <span>County-Wide Coverage</span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Web Design Across Lancashire
      </h2>

      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Based in Blackburn, working across the county and beyond. Face-to-face meetings anywhere in Lancashire; everywhere else by video. We also deliver specialist bespoke <strong>web design north west</strong> wide and take on projects UK-wide — a good half of our work is remote.
      </p>

      <!-- Linked Towns Directory (Zero-JS Accessible) -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
          Primary Service Areas
        </h3>
        <div class="grid grid-cols-2 gap-2.5">
          {towns.map((town) => (
            <a
              href={town.href}
              class="flex items-center justify-between p-2.5 rounded-xl border border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 hover:border-blue-200 dark:hover:border-blue-900 hover:bg-blue-50/50 dark:hover:bg-blue-950/40 transition-colors group"
            >
              <div class="flex items-center gap-2">
                <span class={`w-2 h-2 rounded-full ${town.tier === 1 ? 'bg-blue-600' : 'bg-slate-400'}`}></span>
                <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400">
                  {town.name}
                </span>
              </div>
              {town.postcodes && (
                <span class="text-[10px] text-slate-400 font-mono">
                  {town.postcodes}
                </span>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Right: Static Map Visual with Click-to-Load Interaction Container -->
    <div class="lg:col-span-6">
      <div class="relative w-full aspect-[4/3] rounded-2xl bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 p-6 flex flex-col justify-between overflow-hidden shadow-inner">
        <!-- SVG Graphic Representation of Lancashire Coverage Network -->
        <svg class="absolute inset-0 w-full h-full opacity-40" viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="200" cy="160" r="120" stroke="#2563eb" stroke-width="1" stroke-dasharray="4 4" />
          <circle cx="200" cy="160" r="60" stroke="#2563eb" stroke-width="1" />
          <!-- Hub: Blackburn -->
          <circle cx="220" cy="180" r="6" fill="#3b82f6" />
          <text x="232" y="184" fill="#ffffff" font-size="11" font-weight="bold">Blackburn (Base)</text>
          <!-- Preston -->
          <circle cx="150" cy="160" r="5" fill="#60a5fa" />
          <text x="96" y="164" fill="#94a3b8" font-size="10">Preston</text>
          <!-- Lancaster -->
          <circle cx="160" cy="70" r="5" fill="#60a5fa" />
          <text x="105" y="74" fill="#94a3b8" font-size="10">Lancaster</text>
          <!-- Burnley -->
          <circle cx="280" cy="165" r="4" fill="#64748b" />
          <text x="290" y="169" fill="#64748b" font-size="9">Burnley</text>
          <!-- Blackpool -->
          <circle cx="80" cy="140" r="4" fill="#64748b" />
          <text x="30" y="144" fill="#64748b" font-size="9">Blackpool</text>
          <!-- Connecting lines -->
          <line x1="220" y1="180" x2="150" y2="160" stroke="#3b82f6" stroke-width="1.5" />
          <line x1="150" y1="160" x2="160" y2="70" stroke="#3b82f6" stroke-width="1.5" />
          <line x1="220" y1="180" x2="280" y2="165" stroke="#334155" stroke-width="1" stroke-dasharray="2 2" />
          <line x1="150" y1="160" x2="80" y2="140" stroke="#334155" stroke-width="1" stroke-dasharray="2 2" />
        </svg>

        <div class="relative z-10 flex items-center justify-between">
          <span class="text-xs font-mono font-semibold text-blue-400 bg-blue-950/80 px-2.5 py-1 rounded-md border border-blue-900">
            Lancashire &bull; M65 Tech Corridor
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/80">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Active Regional Coverage</span>
          </span>
        </div>

        <div class="relative z-10 bg-slate-900/90 backdrop-blur-md p-4 rounded-xl border border-slate-800 text-xs text-slate-300">
          <div class="font-bold text-white mb-1">Central Lancashire Tech Corridor</div>
          <div>Direct face-to-face consultations available across Blackburn, Preston, and Lancaster.</div>
        </div>
      </div>
    </div>
  </div>
</section>
