---
import { site } from 'src/data/site';
import Icon from './Icon.astro';

const phoneHref = site.phoneE164 ? `tel:${site.phoneE164}` : undefined;
const whatsAppHref = site.whatsAppE164 ? `https://wa.me/${site.whatsAppE164.replace(/[^0-9]/g, '')}` : undefined;
---

<div class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 p-2.5 sm:hidden shadow-[0_-4px_16px_rgba(0,0,0,0.08)]">
  <div class="flex items-center justify-around gap-2 max-w-md mx-auto">
    {phoneHref && (
      <a
        href={phoneHref}
        class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-xs font-semibold"
      >
        <Icon name="phone" class="w-5 h-5 text-blue-600 mb-0.5" />
        <span>Call Us</span>
      </a>
    )}

    {whatsAppHref && (
      <a
        href={whatsAppHref}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-xs font-semibold"
      >
        <Icon name="mail" class="w-5 h-5 text-emerald-600 mb-0.5" />
        <span>WhatsApp</span>
      </a>
    )}

    <a
      href="/get-a-quote/"
      class="flex-2 flex items-center justify-center gap-1.5 py-2 px-4 rounded-xl bg-blue-600 text-white text-xs font-bold shadow-md hover:bg-blue-700 transition-colors"
    >
      <span>Get a Quote</span>
      <Icon name="arrow-right" class="w-4 h-4" />
    </a>
  </div>
</div>
