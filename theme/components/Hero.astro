---
import Icon from './Icon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProcessTimelineHero from './ProcessTimelineHero.astro';

export interface Props {
  variant?: 'home' | 'service' | 'location' | 'portfolio' | 'blog' | 'legal';
  heading: string;
  subheading?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  badge?: string;
  breadcrumbs?: { name: string; url: string }[];
  class?: string;
}

const {
  variant: _variant = 'home',
  heading,
  subheading,
  primaryCtaText = 'Get a Bespoke Quote',
  primaryCtaHref = '/get-a-quote/',
  secondaryCtaText = 'Explore Pricing',
  secondaryCtaHref = '/pricing/',
  badge = 'Bespoke UK Engineering • No Templates',
  breadcrumbs,
  class: className = ''
} = Astro.props;

// Split heading to apply gradient highlight to the last word
const words = heading.trim().split(' ');
const firstPart = words.length > 1 ? words.slice(0, -1).join(' ') : '';
const highlightWord = words[words.length - 1];
---

<section class={`relative py-14 sm:py-18 md:py-20 lg:py-24 overflow-hidden bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white border-b border-slate-200/80 dark:border-slate-800/80 transition-colors ${className}`}>
  <!-- 1. Architectural Precision Grid -->
  <div class="absolute inset-0 hero-architectural-grid pointer-events-none opacity-70 dark:opacity-80 [mask-image:radial-gradient(ellipse_80%_65%_at_50%_35%,#000_65%,transparent_100%)]"></div>

  <!-- 2. Traveling Animated Laser Beam Lines -->
  <div class="absolute top-[28%] left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-blue-500/20 dark:via-cyan-400/25 to-transparent pointer-events-none overflow-hidden">
    <div class="w-48 h-full bg-gradient-to-r from-transparent via-blue-500 dark:via-cyan-400 to-transparent animate-beam-h"></div>
  </div>
  <div class="absolute bottom-[22%] left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-indigo-500/20 dark:via-blue-400/25 to-transparent pointer-events-none overflow-hidden">
    <div class="w-64 h-full bg-gradient-to-r from-transparent via-indigo-500 dark:via-blue-400 to-transparent animate-beam-h" style="animation-duration: 9s; animation-delay: 2s;"></div>
  </div>

  <!-- 3. Fluid Animated Ambient Gradient Orbs -->
  <div class="absolute -top-24 left-1/4 w-[420px] h-[420px] bg-gradient-to-br from-blue-500/15 to-indigo-500/10 dark:from-blue-600/25 dark:to-indigo-600/15 rounded-full blur-[120px] pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/4 -right-20 w-[450px] h-[450px] bg-gradient-to-br from-cyan-400/15 to-blue-500/15 dark:from-cyan-500/20 dark:to-blue-600/20 rounded-full blur-[130px] pointer-events-none animate-float-slow"></div>
  <div class="absolute -bottom-20 left-10 w-[380px] h-[380px] bg-gradient-to-tr from-indigo-500/10 to-purple-500/10 dark:from-indigo-600/15 dark:to-purple-600/15 rounded-full blur-[110px] pointer-events-none animate-float-reverse"></div>

  <!-- 4. Main Two-Column Content Grid -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Value Proposition & Conversion CTAs -->
      <div class="lg:col-span-6 space-y-6 sm:space-y-7 text-left">
        <!-- Breadcrumbs (if provided on subpages) -->
        {breadcrumbs && breadcrumbs.length > 0 && (
          <Breadcrumbs items={breadcrumbs} class="mb-1" />
        )}

        <!-- Live Status Radar Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-semibold bg-white/80 dark:bg-slate-900/80 backdrop-blur-md text-slate-800 dark:text-slate-200 border border-slate-200/90 dark:border-slate-800 shadow-xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600 dark:bg-cyan-400"></span>
          </span>
          <span class="tracking-wide">{badge}</span>
          <span class="text-slate-300 dark:text-slate-700">|</span>
          <span class="text-blue-600 dark:text-cyan-400 font-bold">100/100 Speed</span>
        </div>

        <!-- Headline with Modern Multi-Stop Gradient Accent -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.08] text-slate-900 dark:text-white">
          {firstPart && <span>{firstPart} </span>}
          <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 dark:from-blue-400 dark:via-cyan-300 dark:to-indigo-300 bg-clip-text text-transparent">
            {highlightWord}
          </span>
        </h1>

        <!-- Subheading -->
        {subheading && (
          <p class="text-lg sm:text-xl leading-relaxed text-slate-600 dark:text-slate-300 max-w-2xl font-normal">
            {subheading}
          </p>
        )}

        <!-- Primary & Secondary CTAs -->
        {(primaryCtaText || secondaryCtaText) && (
          <div class="pt-2 flex flex-wrap items-center gap-4">
            {primaryCtaText && (
              <a
                href={primaryCtaHref}
                class="btn-shimmer group inline-flex items-center gap-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-lg shadow-blue-600/20 hover:shadow-xl hover:shadow-blue-600/30 transition-all duration-150 hover-lift focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
              >
                <span>{primaryCtaText}</span>
                <Icon name="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
              </a>
            )}

            {secondaryCtaText && (
              <a
                href={secondaryCtaHref}
                class="group inline-flex items-center gap-2 font-semibold text-base px-7 py-4 rounded-xl transition-all duration-150 bg-white/90 dark:bg-slate-900/90 text-slate-800 dark:text-slate-200 border border-slate-300/80 dark:border-slate-800 hover:border-blue-500/40 dark:hover:border-blue-500/40 hover:bg-white dark:hover:bg-slate-800 shadow-xs hover-lift focus-visible:ring-2 focus-visible:ring-blue-500"
              >
                {secondaryCtaHref?.startsWith('tel:') ? (
                  <Icon name="phone" class="w-4 h-4 text-blue-600 dark:text-blue-400 shrink-0" />
                ) : null}
                <span>{secondaryCtaText}</span>
                {!secondaryCtaHref?.startsWith('tel:') ? (
                  <Icon name="arrow-right" class="w-4 h-4 text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition-colors" />
                ) : null}
              </a>
            )}
          </div>
        )}

        <!-- Micro Trust Signals Strip -->
        <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800/80 flex flex-wrap items-center gap-6 text-xs text-slate-600 dark:text-slate-400">
          <div class="flex items-center gap-2">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
            <span class="font-medium text-slate-700 dark:text-slate-300">Sub-second mobile load times</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold">✓</span>
            <span class="font-medium text-slate-700 dark:text-slate-300">You own the code outright</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold">✓</span>
            <span class="font-medium text-slate-700 dark:text-slate-300">Direct access to the developer building it</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Hero Quote Form with 9 Floating Framework Badges -->
      <div class="lg:col-span-6 relative mt-6 lg:mt-0">
        <ProcessTimelineHero />
      </div>

    </div>
  </div>
</section>
