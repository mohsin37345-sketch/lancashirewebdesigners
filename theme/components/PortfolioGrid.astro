---
import PortfolioCard from './PortfolioCard.astro';
import Icon from './Icon.astro';

export interface PortfolioItem {
  title: string;
  client: string;
  industry: string;
  year: number;
  href: string;
  brief: string;
  services?: string[];
  metrics?: { label: string; value: string; note?: string }[];
  image?: string;
}

export interface Props {
  items?: PortfolioItem[];
  isHomeSection?: boolean;
  class?: string;
}

const { items = [], isHomeSection = false, class: className = '' } = Astro.props;
---

{items.length > 0 ? (
  <div class={`grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 ${className}`}>
    {items.map((item) => (
      <PortfolioCard {...item} />
    ))}
  </div>
) : isHomeSection ? (
  <!-- On the homepage, self-hide completely when collection is empty rather than showing filler -->
  <div></div>
) : (
  <!-- On /portfolio/, render designed empty state explaining the studio is newly launched -->
  <div class="max-w-2xl mx-auto text-center py-16 px-6 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl space-y-6">
    <div class="w-16 h-16 rounded-2xl bg-blue-50 dark:bg-blue-950/70 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto">
      <Icon name="code" class="w-8 h-8" />
    </div>

    <div class="space-y-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100/70 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300">
        Authenticity Promise
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
        Real Work Only — No Fabricated Case Studies
      </h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-lg mx-auto">
        As a newly launched bespoke studio, we adhere to strict integrity: we refuse to publish stock mockup templates, fictitious metrics, or invented client testimonials. Case studies appear here only as live client engagements conclude.
      </p>
    </div>

    <div class="pt-4 border-t border-slate-200 dark:border-slate-800/80 max-w-md mx-auto">
      <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">
        Interested in seeing live code demonstrations, architectural examples, or discussing your bespoke build?
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/contact/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-colors"
        >
          <span>Start a Direct Conversation</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/get-a-quote/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-sm font-semibold rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
        >
          <span>Request a Quote</span>
        </a>
      </div>
    </div>
  </div>
)}
