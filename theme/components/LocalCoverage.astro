---
import Icon from './Icon.astro';

export interface Props {
  homeAnchor?: string;
  leadSentence?: string;
  class?: string;
}

const {
  homeAnchor = 'web design in Lancashire',
  leadSentence,
  class: className = ''
} = Astro.props;

const hubs = [
  { name: 'Blackburn Web Design', href: '/areas/web-design-blackburn/' },
  { name: 'Preston Web Design', href: '/areas/web-design-preston/' },
  { name: 'Lancaster Web Design', href: '/areas/web-design-lancaster/' },
  { name: 'Burnley Web Design', href: '/areas/web-design-burnley/' },
  { name: 'Blackpool Web Design', href: '/areas/web-design-blackpool/' },
  { name: 'Accrington Web Design', href: '/areas/web-design-accrington/' },
  { name: 'Chorley Web Design', href: '/areas/web-design-chorley/' },
  { name: 'Darwen Web Design', href: '/areas/web-design-darwen/' },
  { name: 'All Lancashire Areas', href: '/areas/' }
];
---

<section class={`py-14 sm:py-16 ${className}`}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/40 p-8 sm:p-10 space-y-6">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          Regional Presence
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Serving Businesses Across Lancashire
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          {leadSentence || `From our studio base in Blackburn, we provide high-performance <a href="/" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">${homeAnchor}</a> for ambitious commercial enterprises across the county.`} We engineer bespoke websites tailored to local industrial, corporate, and retail markets, ensuring lightning-fast load times and strong organic search visibility.
        </p>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          Whether you require a face-to-face planning session or remote sprint delivery, we actively support growing firms throughout Central Lancashire and the Ribble Valley.
        </p>
      </div>

      <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
        {hubs.map((hub) => (
          <a
            href={hub.href}
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:border-blue-500/50 hover:text-blue-600 dark:hover:text-blue-400 shadow-2xs transition-all hover-lift"
          >
            <Icon name="map-pin" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
            <span>{hub.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
