---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  client: string;
  industry: string;
  year: number;
  href: string;
  brief: string;
  services?: string[];
  metrics?: { label: string; value: string; note?: string }[];
  image?: string;
}

const {
  title,
  client,
  industry,
  year,
  href,
  brief,
  services = [],
  metrics = [],
  image
} = Astro.props;
---

<article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between transition-lift hover-lift shadow-sm hover:shadow-md group">
  {image && (
    <div class="aspect-video w-full bg-slate-100 dark:bg-slate-800 overflow-hidden relative">
      <img
        src={image}
        alt={`${title} case study for ${client}`}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="p-6 lg:p-8 space-y-4">
    <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400">
      <span>{client}</span>
      <span>&bull;</span>
      <span>{industry}</span>
      <span>&bull;</span>
      <span>{year}</span>
    </div>

    <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
      <a href={href} class="focus-visible:ring-2 focus-visible:ring-blue-600 rounded">
        {title}
      </a>
    </h3>

    <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
      {brief}
    </p>

    {services.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-2">
        {services.map((s) => (
          <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
            {s}
          </span>
        ))}
      </div>
    )}

    {metrics.length > 0 && (
      <div class="grid grid-cols-2 gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
        {metrics.slice(0, 2).map((m) => (
          <div>
            <div class="text-lg font-black text-slate-900 dark:text-white">{m.value}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">{m.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="p-6 pt-0 flex items-center justify-between border-t border-slate-100 dark:border-slate-800/80">
    <a
      href={href}
      class="text-xs font-bold text-blue-600 dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform"
      aria-label={`Read case study: ${title}`}
    >
      <span>Read Case Study</span>
      <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>
</article>
