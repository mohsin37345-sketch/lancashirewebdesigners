---
import Icon from './Icon.astro';

export interface FeatureItem {
  title: string;
  description: string;
  icon?: string;
}

export interface Props {
  features?: (string | FeatureItem)[];
  class?: string;
}

const { features = [], class: className = '' } = Astro.props;

// Helper to parse features into title and description
const parsedFeatures: FeatureItem[] = features.map((item, index) => {
  if (typeof item === 'object' && item !== null && 'title' in item) {
    return item as FeatureItem;
  }
  const text = String(item).trim();
  if (text.includes(' — ')) {
    const [title, ...rest] = text.split(' — ');
    return { title: title.trim(), description: rest.join(' — ').trim() };
  }
  if (text.includes(': ')) {
    const [title, ...rest] = text.split(': ');
    return { title: title.trim(), description: rest.join(': ').trim() };
  }
  return {
    title: `Feature ${index + 1}`,
    description: text
  };
});
---

{parsedFeatures.length > 0 && (
  <div class={`grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 ${className}`}>
    {parsedFeatures.map((item) => (
      <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center">
          <Icon name={item.icon || 'check'} class="w-5 h-5" />
        </div>
        <p class="card-title text-base font-bold text-slate-900 dark:text-white">
          <strong>{item.title}</strong>
        </p>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          {item.description}
        </p>
      </div>
    ))}
  </div>
)}
