---
import Icon from './Icon.astro';
import { site } from 'src/data/site';
import { heroTechBadges as techBadges } from 'src/data/techStack';

const formAccessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY || '';
---

<div class="relative w-full max-w-xl mx-auto lg:max-w-none pt-8 pb-8 px-4 sm:px-8">
  <!-- Multi-Color Ambient Backlight Glow -->
  <div class="absolute -inset-3 bg-gradient-to-r from-blue-600/20 via-cyan-500/20 via-fuchsia-500/15 to-indigo-600/20 rounded-3xl blur-2xl opacity-70 pointer-events-none animate-pulse-glow"></div>

  <!-- Decorative Circuit Connectors (Visible on desktop) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-25 dark:opacity-35 hidden sm:block">
    <line x1="50%" y1="2%" x2="50%" y2="12%" stroke="currentColor" stroke-dasharray="3 3" class="text-cyan-500" stroke-width="1.5" />
    <line x1="16%" y1="3%" x2="22%" y2="12%" stroke="currentColor" stroke-dasharray="3 3" class="text-emerald-500" stroke-width="1.5" />
    <line x1="84%" y1="3%" x2="78%" y2="12%" stroke="currentColor" stroke-dasharray="3 3" class="text-lime-500" stroke-width="1.5" />
    <line x1="0%" y1="30%" x2="8%" y2="32%" stroke="currentColor" stroke-dasharray="3 3" class="text-orange-500" stroke-width="1.5" />
    <line x1="100%" y1="30%" x2="92%" y2="32%" stroke="currentColor" stroke-dasharray="3 3" class="text-cyan-500" stroke-width="1.5" />
    <line x1="0%" y1="64%" x2="8%" y2="63%" stroke="currentColor" stroke-dasharray="3 3" class="text-blue-500" stroke-width="1.5" />
    <line x1="100%" y1="64%" x2="92%" y2="63%" stroke="currentColor" stroke-dasharray="3 3" class="text-sky-500" stroke-width="1.5" />
    <line x1="26%" y1="98%" x2="30%" y2="88%" stroke="currentColor" stroke-dasharray="3 3" class="text-indigo-500" stroke-width="1.5" />
    <line x1="74%" y1="98%" x2="70%" y2="88%" stroke="currentColor" stroke-dasharray="3 3" class="text-amber-500" stroke-width="1.5" />
  </svg>

  <!-- Floating Orbiting Framework & Language SVG Badges (Desktop) -->
  {techBadges.map((badge) => (
    <div
      class={`absolute ${badge.position} z-20 hidden sm:flex items-center justify-center px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-white dark:bg-white shadow-md hover:shadow-xl border border-slate-200/90 dark:border-slate-300/80 ${badge.anim} transition-all duration-300 hover:scale-115 cursor-default group`}
      title={badge.name}
    >
      <img
        src={badge.src}
        alt={badge.name}
        class="h-5 sm:h-6 w-auto max-w-[68px] sm:max-w-[78px] object-contain select-none"
        loading="eager"
        width="70"
        height="35"
      />

      <!-- Hover Tooltip -->
      <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity bg-slate-900 text-white text-[10px] font-semibold px-2 py-0.5 rounded shadow-md whitespace-nowrap pointer-events-none z-30">
        {badge.name}
      </span>
    </div>
  ))}

  <!-- Central Compact Modern Quote Form Card Container -->
  <div class="relative rounded-2xl sm:rounded-3xl bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800 shadow-2xl p-5 sm:p-7 space-y-3.5 transition-all duration-300">
    
    <!-- Top Terminal Window Controls Bar -->
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-2.5">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
        <span class="ml-2 font-mono text-xs font-semibold text-slate-500 dark:text-slate-400">instant-quote.dev</span>
      </div>
      <div class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] sm:text-[11px] font-mono font-bold text-emerald-600 dark:text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>FAST 24H ESTIMATE</span>
      </div>
    </div>

    <!-- Title & Subheading -->
    <div class="text-left space-y-0.5">
      <div class="flex items-center justify-between">
        <h3 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span>Get a Fixed-Price Quote</span>
        </h3>
        <span class="text-[10px] sm:text-[11px] font-mono font-bold text-blue-600 dark:text-cyan-400 bg-blue-50 dark:bg-blue-950/60 px-2.5 py-0.5 rounded-md border border-blue-200/60 dark:border-blue-800/60">
          No Obligation
        </span>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Direct review by principal UK developer • Transparent pricing.
      </p>
    </div>

    <!-- Interactive Hero Quote Request Form -->
    <form id="hero-quote-form" class="space-y-3 pt-1" novalidate data-email={site.email}>
      <input type="hidden" name="access_key" value={formAccessKey} />
      <input type="hidden" name="to" value={site.email} />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

      <!-- Row 1: Name & Business Email -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="hero-name" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
            Your Name <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="hero-name"
            name="name"
            required
            placeholder="e.g. Rachel Barnes"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs sm:text-sm transition-all shadow-xs"
          />
        </div>
        <div>
          <label for="hero-email" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
            Business Email <span class="text-rose-500">*</span>
          </label>
          <input
            type="email"
            id="hero-email"
            name="email"
            required
            placeholder="rachel@domain.co.uk"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs sm:text-sm transition-all shadow-xs"
          />
        </div>
      </div>

      <!-- Row 2: Phone & Project Type -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label for="hero-phone" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
            Phone / WhatsApp <span class="text-slate-400 dark:text-slate-500 font-normal lowercase">(optional)</span>
          </label>
          <input
            type="tel"
            id="hero-phone"
            name="phone"
            placeholder="e.g. 01772 123456"
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs sm:text-sm transition-all shadow-xs"
          />
        </div>
        <div>
          <label for="hero-project" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
            Project Type <span class="text-rose-500">*</span>
          </label>
          <select
            id="hero-project"
            name="project_type"
            required
            class="w-full px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs sm:text-sm transition-all shadow-xs cursor-pointer"
          >
            <option value="Bespoke Web Design">Bespoke Web Design</option>
            <option value="B2B Web Design">B2B Web Design</option>
            <option value="WordPress Projects">WordPress Projects</option>
            <option value="Ecommerce">Ecommerce</option>
            <option value="Redesign">Website Redesign</option>
            <option value="Speed & SEO">Speed & SEO</option>
            <option value="Care Plan">Care Plan</option>
            <option value="Others">Others / Custom</option>
          </select>
        </div>
      </div>

      <!-- Row 3: Brief Requirements -->
      <div>
        <label for="hero-details" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
          Brief Requirements <span class="text-rose-500">*</span>
        </label>
        <textarea
          id="hero-details"
          name="details"
          rows="2"
          required
          placeholder="e.g. 5-page bespoke redesign, launch in 4 weeks, needs fast lead generation..."
          class="w-full px-3.5 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 text-xs sm:text-sm transition-all shadow-xs resize-none"
        ></textarea>
      </div>

      <!-- Submission Status Notification -->
      <div id="hero-status" class="hidden p-2.5 rounded-lg text-xs font-medium" role="status" aria-live="polite"></div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="hero-submit"
        class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-lg shadow-blue-600/25 hover:shadow-blue-600/40 transition-all hover-lift focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50 cursor-pointer"
      >
        <span id="hero-btn-text">Get My Free Quote</span>
        <Icon name="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
      </button>

      <!-- Trust Signals Below Button -->
      <div class="flex items-center justify-between text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 pt-1.5 border-t border-slate-100 dark:border-slate-800/80">
        <span class="flex items-center gap-1">
          <span class="text-emerald-500 font-bold">✓</span> Free Consultation
        </span>
        <span class="flex items-center gap-1">
          <span class="text-blue-500 font-bold">✓</span> No Spam Guarantee
        </span>
        <span class="flex items-center gap-1">
          <span class="text-emerald-500 font-bold">✓</span> Same-Day Callback
        </span>
      </div>
    </form>

    <!-- Mobile-Only Tech Framework Badges (Clean Wrapping Chip Row) -->
    <div class="sm:hidden pt-2.5 border-t border-slate-100 dark:border-slate-800/60 space-y-1.5">
      <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider text-slate-400">
        <span>Verified Tech Stack</span>
        <span class="text-emerald-500 font-bold">9 Technologies</span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        {techBadges.map((badge) => (
          <div class="px-2 py-1 rounded-lg bg-white dark:bg-white shadow-2xs border border-slate-200/80 flex items-center justify-center" title={badge.name}>
            <img src={badge.src} alt={badge.name} class="h-3.5 w-auto object-contain" width="48" height="24" />
          </div>
        ))}
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById('hero-quote-form');
    const statusDiv = document.getElementById('hero-status');
    const submitBtn = document.getElementById('hero-submit');
    const btnText = document.getElementById('hero-btn-text');

    if (!form || !statusDiv || !submitBtn || !btnText) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('hero-name')?.value.trim();
      const email = document.getElementById('hero-email')?.value.trim();
      const details = document.getElementById('hero-details')?.value.trim();

      if (!name || !email || !details) {
        statusDiv.className = 'p-2.5 rounded-lg text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-950/60 dark:text-rose-200 dark:border-rose-800/60';
        statusDiv.textContent = 'Please fill in your name, email, and requirements.';
        statusDiv.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      btnText.textContent = 'Sending Request...';
      statusDiv.className = 'p-2.5 rounded-lg text-xs font-medium bg-blue-50 text-blue-800 border border-blue-200 dark:bg-blue-950/60 dark:text-blue-200 dark:border-blue-800/60';
      statusDiv.textContent = 'Submitting your quote request...';
      statusDiv.classList.remove('hidden');

      const formData = new FormData(form);
      const accessKey = form.querySelector('input[name="access_key"]')?.value;
      const targetEmail = form.getAttribute('data-email') || 'lancashirewebdesigners@gmail.com';

      try {
        let sent = false;

        // 1. Try Web3Forms if access key is present
        if (accessKey && accessKey.trim().length > 0) {
          try {
            const res = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              body: formData
            });
            const data = await res.json();
            if (res.ok && data.success) {
              sent = true;
            }
          } catch (e) {
            // Fall through to FormSubmit
          }
        }

        // 2. Fall back to FormSubmit directly
        if (!sent) {
          const fsResponse = await fetch(`https://formsubmit.co/ajax/${targetEmail}`, {
            method: 'POST',
            headers: {
              'Accept': 'application/json'
            },
            body: formData
          });
          const fsData = await fsResponse.json();

          if (fsResponse.ok && (fsData.success === 'true' || fsData.success === true)) {
            sent = true;
          } else if (fsData.message && fsData.message.toLowerCase().includes('activation')) {
            submitBtn.disabled = false;
            btnText.textContent = 'Request Queued';
            statusDiv.className = 'p-2.5 rounded-lg text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-200 dark:border-amber-800/60';
            statusDiv.innerHTML = `Quote request received! A one-time activation email was sent to <strong>${targetEmail}</strong>. Please click <em>'Activate Form'</em> in that email to enable instant notifications.`;
            return;
          } else {
            throw new Error(fsData.message || 'Submission failed');
          }
        }

        if (sent) {
          window.location.href = '/thank-you/';
        }
      } catch (err) {
        submitBtn.disabled = false;
        btnText.textContent = 'Retry Request';
        statusDiv.className = 'p-2.5 rounded-lg text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-950/60 dark:text-rose-200 dark:border-rose-800/60';
        const fallbackEmail = form.getAttribute('data-email') || 'lancashirewebdesigners@gmail.com';
        const nameVal = form.querySelector('[name="name"]')?.value || '';
        const emailVal = form.querySelector('[name="email"]')?.value || '';
        const detailsVal = form.querySelector('[name="details"]')?.value || '';
        const mailSubject = encodeURIComponent('New Website Project Enquiry');
        const mailBody = encodeURIComponent(`Name: ${nameVal}\nEmail: ${emailVal}\nDetails: ${detailsVal}`);
        statusDiv.innerHTML = `Unable to send via automated gateway. <a href="mailto:${fallbackEmail}?subject=${mailSubject}&body=${mailBody}" class="underline font-bold text-rose-900 dark:text-rose-100">Click here to email directly to ${fallbackEmail}</a>.`;
      }
    });
  })();
</script>
