---
import { site } from 'src/data/site';
import Icon from './Icon.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const founderName = site.founder?.name || 'Mohsin Ali';
const founderRole = 'Mohsin Ali, founder and lead developer';
const founderLinkedin = site.founder?.linkedin || 'https://www.linkedin.com/in/iammohsinmughal/';
---

<section class={`py-16 lg:py-20 bg-slate-50/70 dark:bg-slate-900/40 border-y border-slate-200 dark:border-slate-800 ${className}`}>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 sm:p-10 lg:p-12 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Photo Column -->
        <div class="lg:col-span-4 flex flex-col items-center sm:items-start text-center sm:text-left">
          <div class="relative w-40 h-40 sm:w-48 sm:h-48 rounded-2xl overflow-hidden shadow-lg border-2 border-slate-200 dark:border-slate-700">
            <img
              src="/images/mohsin-ali-founder.jpg"
              alt="Mohsin Ali, founder and lead developer at Lancashire Web Designers"
              width="240"
              height="240"
              class="w-full h-full object-cover object-top"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="mt-4">
            <div class="font-extrabold text-slate-900 dark:text-white text-lg">
              {founderName}
            </div>
            <div class="text-xs font-semibold text-blue-600 dark:text-blue-400">
              Founder & Lead Developer
            </div>
            <div class="mt-2">
              <a
                href={founderLinkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-600 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400 transition-colors"
                aria-label="Connect with Mohsin Ali on LinkedIn"
              >
                <Icon name="linkedin" class="w-3.5 h-3.5 text-blue-600 dark:text-blue-400" />
                <span>Connect on LinkedIn</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Bio & Value Proposition Column -->
        <div class="lg:col-span-8 space-y-4 text-left">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Direct Technical Partnership
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {founderRole}
          </h2>

          <p class="text-base text-slate-700 dark:text-slate-300 font-medium leading-relaxed">
            &ldquo;You deal with the person building your site.&rdquo;
          </p>

          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            With 4+ years in SEO, Google Ads, Meta Ads, WordPress, and Shopify—alongside a BSc (Hons) in Computer Science—I bridge the gap between technical engineering and commercial revenue generation.
          </p>

          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            When you partner with Lancashire Web Designers, there are no account managers playing telephone, no outsourced junior developers, and no misunderstood briefs. Every technical decision, performance optimisation, and conversion architecture is managed directly by me.
          </p>

          <div class="pt-3 flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              BSc (Hons) Computer Science
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              4+ Years SEO & Paid Media
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              WordPress & Shopify Specialist
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Based in Blackburn, Lancashire
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
