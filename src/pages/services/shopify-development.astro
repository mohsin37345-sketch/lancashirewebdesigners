---
import ServiceLayout from 'theme/layouts/ServiceLayout.astro';
import FeatureCards from 'theme/components/FeatureCards.astro';
import TechStack from 'theme/components/TechStack.astro';
import PortfolioShowcase from 'theme/components/PortfolioShowcase.astro';
import PricingAnchor from 'theme/components/PricingAnchor.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import FounderBlock from 'theme/components/FounderBlock.astro';
import LocalCoverage from 'theme/components/LocalCoverage.astro';
import FAQ from 'theme/components/FAQ.astro';
import RelatedServices from 'theme/components/RelatedServices.astro';
import QuoteFormInline from 'theme/components/QuoteFormInline.astro';
import Icon from 'theme/components/Icon.astro';
import { getEntry, getCollection } from 'astro:content';

const serviceEntry = await getEntry('services', 'shopify-development');
if (!serviceEntry) {
  throw new Error('Service entry shopify-development not found');
}
const data = serviceEntry.data;

const allProjects = await getCollection('portfolio');
const shopifyProjects = allProjects
  .filter((p) => ['kifl-fashion-store', 'haul-uk-international', 'smart-rcm-billing'].includes(p.id))
  .map((p) => ({
    title: p.data.title,
    client: p.data.client,
    industry: p.data.industry,
    href: `/portfolio/${p.data.slug || p.id}/`,
    brief: p.data.brief,
    metrics: p.data.metrics
  }));

const relatedServicesList = [
  {
    title: 'Ecommerce Web Design',
    href: '/ecommerce-web-design/',
    description: 'High-converting online store architectures engineered for friction-free purchasing.',
    icon: 'shopping-bag'
  },
  {
    title: 'Website Speed Optimisation',
    href: '/services/website-speed-optimisation/',
    description: 'Audit and remediate heavy JavaScript, app script bloat, and slow mobile checkout times.',
    icon: 'zap'
  },
  {
    title: 'Website Support & Care',
    href: '/website-support/',
    description: 'Proactive maintenance, app monitoring, and dedicated developer hours without lock-in.',
    icon: 'shield-check'
  }
];

const heroTrustBullets = [
  'Custom Liquid 2.0 themes without theme bloat',
  'Shopify Functions & Checkout Extensibility architecture',
  'App audit & monthly subscription reduction',
  'Direct communication with Mohsin Ali'
];
---

<ServiceLayout
  title={data.metaTitle}
  description={data.metaDescription}
  h1={data.heroHeading}
  heroSubheading={data.heroSubheading}
  heroEyebrow="Shopify Development Lancashire • Modern Ecommerce"
  heroTrustBullets={heroTrustBullets}
  serviceType="Shopify Development"
  priceFrom={data.priceFrom}
  faqs={data.faqs}
  faqIntro="Straightforward answers about our custom Liquid development, migrations, Checkout Extensibility, and app reduction."
>
  <article class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Section 1: Intro (Primary keyword in first 100 words) -->
      <div class="max-w-4xl space-y-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          High-Performance Commerce
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Custom Shopify Development Lancashire Brands Rely On for Frictionless Checkout
        </h2>
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
          Choosing bespoke <strong>shopify development lancashire</strong> gives your retail enterprise an ultra-fast, tailored storefront that turns casual mobile browsers into loyal repeat customers. By hand-crafting Liquid templates, leveraging Shopify Functions, and replacing expensive third-party apps with native theme features, we build stores that look exceptional and load instantaneously.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          Commercial themes sold on the Shopify Theme Store must accommodate thousands of varied merchants, cramming hundreds of unused settings and heavy scripts into your store. We strip away this unnecessary complexity, leaving only purposeful, high-speed code that boosts your conversion rates.
        </p>
      </div>

      <!-- Section 2: Feature Cards (<p class="card-title"><strong>) -->
      <div class="space-y-6">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Technical Capabilities
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Engineered for Retail Revenue
          </h2>
        </div>
        <FeatureCards features={data.benefits} />
      </div>

      <!-- Section 3: Deep-dive H2 - Custom Shopify Theme Development vs Commercial Themes -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-8 sm:p-12 space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Liquid Engineering
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Custom Shopify Theme Development vs Commercial Themes
          </h2>
          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            Many merchants install a commercial theme, only to discover that adding essential features requires stacking twenty different monthly subscription apps. Each app injects external JavaScript, slows down mobile checkouts, and eats away at your operating margin.
          </p>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Our custom Shopify Online Store 2.0 themes incorporate native mega menus, slide-out carts, custom swatch selectors, and trust badges directly into the Liquid codebase. You save hundreds of pounds in app fees each year while ensuring sub-second page performance on mobile networks.
          </p>
        </div>
      </div>

      <!-- Section 4: Deep-dive H2 - Shopify Functions & Checkout Extensibility -->
      <div class="space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Modern Checkout Architecture
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Shopify Functions & Checkout Extensibility (Replacing Legacy Scripts)
          </h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Shopify has deprecated legacy checkout scripts in favour of Shopify Functions and Checkout Extensibility. We engineer native server-side logic using Shopify Functions for volume discounts, customized shipping options, and B2B customer validations, providing enterprise-grade reliability and security.
          </p>
        </div>

        <TechStack />
      </div>

      <!-- Section 5: Process (5-stage) -->
      <div class="space-y-8">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Methodical Delivery
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Our 5-Stage Shopify Development Process
          </h2>
          <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm">
            From catalogue architecture to merchant payment verification and launch.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.process.map((step) => (
            <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs space-y-3">
              <div class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400">Step {step.step}</div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 6: Inclusions / Boundaries -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="p-8 rounded-3xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/30 dark:bg-emerald-950/20 space-y-4">
          <h3 class="text-xl font-bold text-emerald-950 dark:text-emerald-300 flex items-center gap-2">
            <Icon name="check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            <span>Included in Custom Shopify Builds</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-700 dark:text-slate-300">
            {data.whatsIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-4">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>Transparent Boundaries (Optional Add-ons)</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-400">
            {data.whatsNotIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-slate-400 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Section 7: Case Studies / Portfolio Showcase (USER REQUEST) -->
      <PortfolioShowcase
        heading="Shopify Case Studies & Client Stores"
        subheading="Live retail and trade storefronts engineered with bespoke Liquid code and friction-free checkouts."
        items={shopifyProjects}
      />

      <!-- Section 8: Deep-dive H2 - Migrating to Shopify: Seamless Catalogue & Customer Data Transfer -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-8 sm:p-12 space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Safe Migrations
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Migrating to Shopify: Seamless Catalogue & Customer Data Transfer
          </h2>
          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            Transitioning from WooCommerce, Magento, or an outdated bespoke shopping cart requires careful planning. We manage secure database extracts and automated imports for your entire product catalogue, variant trees, historical customer orders, and customer accounts.
          </p>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Most importantly, we construct exhaustive 301 URL redirect maps so your historical Google rankings and external backlink equity are completely preserved without dead 404 links.
          </p>
        </div>
      </div>

      <!-- Section 9: Deep-dive H2 & Pricing Anchor - Ongoing Shopify Growth & Conversion Tuning -->
      <div class="space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Investment Overview
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Ongoing Shopify Growth & Conversion Tuning
          </h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Our custom Shopify storefront builds start from £500 for focused boutique stores with full payment gateway setup, scaling to £1,200+ for large catalogue migrations and enterprise B2B setups.
          </p>
        </div>

        <PricingAnchor
          priceFrom={data.priceFrom}
          priceUnit="fixed project"
          whatsIncluded={data.whatsIncluded}
          title="Shopify Builds from £500"
          subtitle="Fixed milestone pricing with zero hidden theme fees, reduced app overhead, and full merchant control."
        />
      </div>

      <!-- Section 10: Client Testimonials & Reviews (USER REQUEST) -->
      <Testimonials
        heading="Merchant Reviews & Trust"
        subheading="What store owners and brand directors say about working directly with Mohsin Ali."
      />

      <!-- Section 11: Founder Block -->
      <FounderBlock />

      <!-- Section 12: Local Coverage -->
      <LocalCoverage
        homeAnchor="Lancashire Shopify developer"
        leadSentence="From our studio in Blackburn, we engineer custom Shopify storefronts for retailers and independent brands across the North West."
      />

      <!-- Section 13: FAQs -->
      <FAQ
        faqs={data.faqs}
        heading="Frequently Asked Questions"
        intro="Have questions about Shopify migrations, Liquid themes, or reducing app subscriptions? Here are clear answers."
      />

      <!-- Section 14: Related Services -->
      <RelatedServices
        services={relatedServicesList}
        heading="Explore Related Services"
        subheading="Connected solutions to support your online retail visibility, speed, and continuous maintenance."
      />

      <!-- Section 15: Inline Quote Form -->
      <div class="max-w-2xl mx-auto pt-8">
        <QuoteFormInline
          heading="Build Your Custom Shopify Store"
          subheading="Direct consultation with Mohsin Ali, founder and lead developer. Fixed-price proposals delivered within 24 hours."
          submitLabel="Request Shopify Proposal"
        />
      </div>

    </div>
  </article>
</ServiceLayout>
