---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import navData from 'src/data/navigation.json';
import { getCollection } from 'astro:content';

export const prerender = true;

// Core static pages
const corePages = [
  { name: 'Homepage', url: '/' },
  { name: 'About Studio', url: '/about/' },
  { name: 'How It Works', url: '/how-it-works/' },
  { name: 'Pricing & Packages', url: '/pricing/' },
  { name: 'Portfolio (Case Studies)', url: '/portfolio/' },
  { name: 'Client Reviews', url: '/reviews/' },
  { name: 'Frequently Asked Questions', url: '/faqs/' },
  { name: 'Get a Quote', url: '/get-a-quote/' },
  { name: 'Website Cost Calculator', url: '/website-cost-calculator/' },
  { name: 'Free Website Audit', url: '/free-website-audit/' },
  { name: 'Contact Studio', url: '/contact/' },
  { name: 'HTML Sitemap', url: '/sitemap/' }
];

// Legal pages
const legalPages = [
  { name: 'Privacy Policy', url: '/privacy-policy/' },
  { name: 'Terms & Conditions', url: '/terms-and-conditions/' },
  { name: 'Terms of Business (Contract)', url: '/terms-of-business/' },
  { name: 'Cookie Policy', url: '/cookie-policy/' },
  { name: 'Accessibility Statement', url: '/accessibility-statement/' },
  { name: 'Complaints Procedure', url: '/complaints-procedure/' }
];

// Dynamically fetch content collections if entries exist
let services: any[] = [];
let locations: any[] = [];
let serviceAreas: any[] = [];
let portfolio: any[] = [];
let blogPosts: any[] = [];

try {
  services = await getCollection('services');
} catch (e) {
  services = [];
}

try {
  locations = await getCollection('locations');
} catch (e) {
  locations = [];
}

try {
  serviceAreas = await getCollection('serviceAreas');
} catch (e) {
  serviceAreas = [];
}

try {
  portfolio = await getCollection('portfolio');
} catch (e) {
  portfolio = [];
}

try {
  blogPosts = await getCollection('blog');
} catch (e) {
  blogPosts = [];
}

// Fallback navigation items for services and areas defined in navigation config
const plannedServices = navData.footerNav.services;
const plannedAreas = navData.footerNav.areas;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Sitemap', url: '/sitemap/' }
];
---

<BaseLayout
  title="HTML Sitemap | Lancashire Web Designers"
  description="Comprehensive index of all web design services, regional Lancashire coverage locations, portfolio studies, and legal documents."
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Website Directory & Sitemap
        </h1>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-400">
          Navigate through our full hierarchy of pages, bespoke service specifications, Lancashire regional locations, and technical insights.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      <!-- 1. Core & Conversion Pages -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          Core & Company
        </h2>
        <ul class="space-y-2 text-sm">
          {corePages.map((page) => (
            <li>
              <a href={page.url} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                {page.name}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- 2. Services -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          Bespoke Services
        </h2>
        <ul class="space-y-2 text-sm">
          {services.length > 0 ? (
            services.map((item) => (
              <li>
                <a href={`/${item.data.slug || item.id}/`} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  {item.data.title}
                </a>
              </li>
            ))
          ) : (
            plannedServices.map((item) => (
              <li>
                <a href={item.href} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          )}
        </ul>
      </section>

      <!-- 3. Regional Locations -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          Lancashire Service Areas
        </h2>
        <ul class="space-y-2 text-sm">
          {locations.length > 0 ? (
            locations.map((item) => (
              <li>
                <a href={`/areas/web-design-${item.data.slug || item.id}/`} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  Web Design {item.data.town}
                </a>
              </li>
            ))
          ) : (
            plannedAreas.map((item) => (
              <li>
                <a href={item.href} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          )}
        </ul>
      </section>

      <!-- 4. Service x Location Matrix -->
      {serviceAreas.length > 0 && (
        <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
            Bespoke Regional Hubs
          </h2>
          <ul class="space-y-2 text-sm">
            {serviceAreas.map((sa) => (
              <li>
                <a href={`/${sa.data.service}/${sa.data.location}/`} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors capitalize">
                  {sa.data.service.replace(/-/g, ' ')} ({sa.data.location})
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- 5. Case Studies -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          Portfolio & Case Studies
        </h2>
        {portfolio.length > 0 ? (
          <ul class="space-y-2 text-sm">
            {portfolio.map((p) => (
              <li>
                <a href={`/portfolio/${p.data.slug || p.id}/`} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs text-slate-500 dark:text-slate-400 italic">
            New case studies will populate here upon initial client engagement completions.
          </p>
        )}
      </section>

      <!-- 6. Blog & Insights -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          Blog & Technical Guides
        </h2>
        {blogPosts.length > 0 ? (
          <ul class="space-y-2 text-sm">
            {blogPosts.map((b) => (
              <li>
                <a href={`/blog/${b.id}/`} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  {b.data.title}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-xs text-slate-500 dark:text-slate-400 italic">
            Editorial articles will appear here as technical guides are published.
          </p>
        )}
      </section>

      <!-- 7. Legal & Compliance -->
      <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-2xs space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white border-b border-slate-100 dark:border-slate-800 pb-3">
          Legal & Compliance
        </h2>
        <ul class="space-y-2 text-sm">
          {legalPages.map((page) => (
            <li>
              <a href={page.url} class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                {page.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
