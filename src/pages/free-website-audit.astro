---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import AuditRequestForm from 'theme/components/AuditRequestForm.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Icon from 'theme/components/Icon.astro';

const title = 'Free Website Performance Audit | Lancashire Web Designers';
const description = 'Claim your free forensic website audit. We evaluate mobile Core Web Vitals, technical on-page SEO, WCAG accessibility, and security with zero obligation.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Free Website Audit', url: '/free-website-audit/' }
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="article"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Free Forensic Website Audit
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Discover why your current website is lagging behind competitors, bouncing mobile traffic, or failing to generate qualified commercial leads.
        </p>
      </div>
    </div>
  </div>

  <TrustStrip />

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left: What We Audit -->
        <div class="lg:col-span-5 space-y-6">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Comprehensive Inspection
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            What Our Technical Diagnostic Covers
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            This is not an automated spam report. A senior web developer manually inspects your domain and provides actionable findings:
          </p>

          <div class="space-y-4 pt-2">
            <div class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 flex items-start gap-3.5">
              <Icon name="zap" class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" />
              <div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">Google Core Web Vitals & Load Latency</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Real-world Largest Contentful Paint (LCP), Interaction to Next Paint (INP), and layout shifts.</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 flex items-start gap-3.5">
              <Icon name="search" class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
              <div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">Technical On-Page SEO & Schema Integrity</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Heading hierarchy structure, metadata verification, crawl barriers, and JSON-LD syntax.</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 flex items-start gap-3.5">
              <Icon name="shield-check" class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
              <div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">Mobile Ergonomics & Conversion Funnels</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Tap targets, form validation friction, viewport responsiveness, and SSL security posture.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Request Form -->
        <div class="lg:col-span-7">
          <AuditRequestForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
