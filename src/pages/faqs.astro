---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import allFaqsData from 'src/data/faqs.json';

const title = 'Frequently Asked Questions | Lancashire Web Designers';
const description = 'Find answers to common questions about our bespoke development process, pricing, timeline, SEO standards, and code ownership policies.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'FAQs', url: '/faqs/' }
];

const generalFaqs = allFaqsData;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="article"
  breadcrumbs={breadcrumbs}
  faqs={generalFaqs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Frequently Asked Questions
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Straightforward answers about our engineering standards, milestone delivery, fixed pricing, and intellectual property ownership.
        </p>
      </div>
    </div>
  </div>

  <div class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <FAQ
        faqs={generalFaqs}
        heading="Everything You Need to Know"
        subheading="If your question is not addressed here, speak directly with our senior developer."
      />
    </div>
  </div>

  <CTABand
    heading="Have a question about a unique technical requirement?"
    subheading="Speak directly with our principal software architect for honest, transparent advice."
    primaryCtaText="Speak with an Engineer"
    primaryCtaHref="/contact/"
    secondaryCtaText="Get a Project Quote"
    secondaryCtaHref="/get-a-quote/"
  />
</BaseLayout>
