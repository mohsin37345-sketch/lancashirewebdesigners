---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import CostCalculator from 'theme/components/CostCalculator.astro';
import PricingTable from 'theme/components/PricingTable.astro';
import CTABand from 'theme/components/CTABand.astro';

const title = 'Website Cost Calculator | Lancashire Web Designers';
const description = 'Estimate your bespoke website design and development investment. Select page counts, ecommerce, CMS, and SEO options for instant indicative pricing.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Cost Calculator', url: '/website-cost-calculator/' }
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="article"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Bespoke Website Cost Calculator
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Get an instant, transparent estimate for your web development project based on your specific commercial scope and custom integration requirements.
        </p>
      </div>
    </div>
  </div>

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <CostCalculator />
    </div>
  </section>

  <PricingTable />

  <CTABand
    heading="Have complex bespoke software requirements?"
    subheading="Speak directly with our technical lead for a custom architectural proposal and fixed-price quotation."
    primaryCtaText="Speak with an Engineer"
    primaryCtaHref="/contact/"
    secondaryCtaText="Get a Formal Quote"
    secondaryCtaHref="/get-a-quote/"
  />
</BaseLayout>
