---
import type { GetStaticPathsOptions, Page } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import BlogGrid from 'theme/components/BlogGrid.astro';
import Pagination from 'theme/components/Pagination.astro';
import CTABand from 'theme/components/CTABand.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(sortedPosts, { pageSize: 6 });
}

export interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

const title = page.currentPage > 1
  ? `Insights & Articles - Page ${page.currentPage} | Lancashire Web Designers`
  : 'Web Design & Development Insights | Lancashire Web Designers';

const description = 'Practical guides, performance case studies, and engineering strategies for ambitious UK businesses from Lancashire Web Designers.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' }
];

const postsList = page.data.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  href: `/blog/${post.id}/`,
  date: post.data.date,
  category: post.data.category,
  author: post.data.author,
  image: post.data.image
}));
---

<BaseLayout
  title={title}
  description={description}
  schemaType="article"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Web Design Insights & Engineering
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Technical breakdowns, SEO best practices, and performance engineering insights directly from our senior web development team.
        </p>
      </div>
    </div>
  </div>

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <BlogGrid posts={postsList} />

      {page.total > page.size && (
        <Pagination
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          baseUrl="/blog/"
          totalItems={page.total}
        />
      )}
    </div>
  </section>

  <CTABand
    heading="Need technical advice on your company website?"
    subheading="Speak directly with our senior development team. Fixed-price proposals delivered in 24 hours."
    primaryCtaText="Get a Bespoke Quote"
    primaryCtaHref="/get-a-quote/"
    secondaryCtaText="Calculate Project Cost"
    secondaryCtaHref="/website-cost-calculator/"
  />
</BaseLayout>
