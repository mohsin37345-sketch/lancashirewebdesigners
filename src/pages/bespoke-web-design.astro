---
import ServiceLayout from 'theme/layouts/ServiceLayout.astro';
import FeatureCards from 'theme/components/FeatureCards.astro';
import ComparisonTable from 'theme/components/ComparisonTable.astro';
import TechStack from 'theme/components/TechStack.astro';
import PortfolioShowcase from 'theme/components/PortfolioShowcase.astro';
import PricingAnchor from 'theme/components/PricingAnchor.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import FounderBlock from 'theme/components/FounderBlock.astro';
import LocalCoverage from 'theme/components/LocalCoverage.astro';
import FAQ from 'theme/components/FAQ.astro';
import RelatedServices from 'theme/components/RelatedServices.astro';
import QuoteFormInline from 'theme/components/QuoteFormInline.astro';
import DesignProcessVisuals from 'theme/components/DesignProcessVisuals.astro';
import Icon from 'theme/components/Icon.astro';
import { getEntry, getCollection } from 'astro:content';

const serviceEntry = await getEntry('services', 'bespoke-web-design');
if (!serviceEntry) {
  throw new Error('Service entry bespoke-web-design not found');
}
const data = serviceEntry.data;

const allProjects = await getCollection('portfolio');
const caseStudyProjects = allProjects
  .filter((p) => ['haul-uk-international', 'bitlance-group', 'the-royals-removals'].includes(p.id))
  .map((p) => ({
    title: p.data.title,
    client: p.data.client,
    industry: p.data.industry,
    href: `/portfolio/${p.data.slug || p.id}/`,
    brief: p.data.brief,
    metrics: p.data.metrics
  }));

const relatedServicesList = [
  {
    title: 'B2B Web Design',
    href: '/b2b-web-design/',
    description: 'High-conversion lead engineering and CRM pipelines for Lancashire trade and manufacturing companies.',
    icon: 'layers'
  },
  {
    title: 'Ecommerce Web Design',
    href: '/ecommerce-web-design/',
    description: 'Fast, secure Shopify and WooCommerce stores built for frictionless purchasing.',
    icon: 'shopping-bag'
  },
  {
    title: 'Website Redesign',
    href: '/services/website-redesign/',
    description: 'Modernise legacy platforms with zero SEO traffic loss and comprehensive 301 URL mapping.',
    icon: 'refresh-cw'
  }
];

const heroTrustBullets = [
  'Zero bloated templates or slow page builders',
  'Sub-second mobile rendering speeds',
  '100% intellectual property & code ownership',
  'Direct communication with Mohsin Ali'
];
---

<ServiceLayout
  title={data.metaTitle}
  description={data.metaDescription}
  h1={data.heroHeading}
  heroSubheading={data.heroSubheading}
  heroEyebrow="Bespoke Web Designers • Lancashire"
  heroTrustBullets={heroTrustBullets}
  serviceType="Bespoke Web Design"
  priceFrom={data.priceFrom}
  faqs={data.faqs}
  faqIntro="Everything you need to know about bespoke web design in Lancashire: process, pricing, ownership and working with local web designers."
>
  <article class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Section 1: Intro (Primary keyword in first 100 words) -->
      <div class="max-w-4xl space-y-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          Hand-Crafted Performance
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Bespoke Web Design Lancashire Businesses Can Grow With
        </h2>
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
          <strong>Bespoke web design</strong> means your website is planned, designed and coded for your business alone. As independent <strong>web designers in Lancashire</strong>, we don't install a theme and swap the logo. We start from a blank canvas and build every page around what your customers need to see before they pick up the phone or send an enquiry.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          Most cheap websites are built on multi-purpose themes or page builders that load thousands of lines of unused code on every page. That makes them slow on mobile, harder for Google to rank and a constant source of plugin updates and security patches. A hand-coded bespoke website avoids all of that: it loads in under a second, works properly on every device and keeps visitors moving towards your contact form.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          Whether you're a Blackburn manufacturer, a Preston law firm or a Burnley trades business, you deal directly with the person designing and building your site. No account managers, no outsourcing, no templates.
        </p>
      </div>

      <!-- Section 2: Feature Cards (<p class="card-title"><strong>) -->
      <div class="space-y-6">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Core Advantages
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Engineered Exclusively for Your Business Needs
          </h2>
        </div>
        <FeatureCards features={data.benefits} />
      </div>

      <!-- Section 3: Deep-dive H2 - What Bespoke Web Design Actually Means -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-8 sm:p-12 space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Technical Distinction
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            What Bespoke Web Design Actually Means
          </h2>
          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            The web design industry is flooded with agencies charging bespoke prices for pre-made WordPress themes or drag-and-drop Elementor layouts. Authentic bespoke web design means writing clean semantic markup from scratch without inheriting hundreds of kilobytes of unused vendor styles.
          </p>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            When your code is clean, search engines crawl your pages effortlessly. You eliminate plugin conflicts, reduce server memory usage, and retain complete control over your technical roadmap without vendor lock-in.
          </p>
        </div>
      </div>

      <!-- Section 4: Deep-dive H2 - Bespoke Web Development: How We Build -->
      <div class="space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Modern Tech Stack
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Bespoke Web Development: How We Build
          </h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            We build modern web architectures using Astro, Tailwind CSS, TypeScript, and high-performance headless or native CMS backends. Every project is strictly benchmarked against Google Core Web Vitals to deliver sub-second Largest Contentful Paint (LCP) and zero Cumulative Layout Shift (CLS).
          </p>
        </div>

        <ComparisonTable />
        <TechStack />
      </div>

      <!-- Section: Visual Architecture & Wireframing Process -->
      <DesignProcessVisuals
        heading="Bespoke Architecture & Wireframing Methodology"
        subheading="How we translate your commercial objectives into tactile wireframe sketches and modern, sub-second web standards before coding begins."
      />

      <!-- Section 5: Process (5-stage) -->
      <div class="space-y-8">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Structured Execution
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Our 5-Stage Bespoke Development Lifecycle
          </h2>
          <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm">
            Milestone-driven project delivery with complete technical transparency at every phase.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.process.map((step) => (
            <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs space-y-3">
              <div class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400">Step {step.step}</div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 6: Inclusions & Clear Boundaries -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="p-8 rounded-3xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/30 dark:bg-emerald-950/20 space-y-4">
          <h3 class="text-xl font-bold text-emerald-950 dark:text-emerald-300 flex items-center gap-2">
            <Icon name="check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            <span>What Is Included</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-700 dark:text-slate-300">
            {data.whatsIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-4">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>Transparent Boundaries (Optional Add-ons)</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-400">
            {data.whatsNotIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-slate-400 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Section 7: Case Studies / Portfolio Showcase (USER REQUEST) -->
      <PortfolioShowcase
        heading="Recent Bespoke Websites by Our Lancashire Web Designers"
        subheading="Real commercial platforms hand-crafted for logistics, transport, and technology businesses."
        items={caseStudyProjects}
      />

      <!-- Section 8: Deep-dive H2 - Bespoke Web Design in Lancashire -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-8 sm:p-12 space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            County-Wide Impact
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Web Designers in Lancashire, Building Bespoke Websites Locally
          </h2>
          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            Choosing local <strong>web designers in Lancashire</strong> means working with someone who knows your market. From our studio in Blackburn we build bespoke websites for manufacturers and logistics firms along the M65 corridor, professional practices in Preston, tourism and hospitality businesses in Blackpool and Lancaster, and trades and family firms across the Ribble Valley.
          </p>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Local knowledge shapes the build. We plan pages and content around the towns your customers actually search from, set up your Google Business Profile and local schema correctly, and write copy that speaks to Lancashire buyers, whether that's a procurement team reviewing suppliers or a homeowner looking for a trusted local trade.
          </p>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            We regularly work with businesses in
            <a href="/areas/web-design-blackburn/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">Blackburn</a>,
            <a href="/areas/web-design-preston/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">Preston</a>,
            <a href="/areas/web-design-burnley/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">Burnley</a>,
            <a href="/areas/web-design-blackpool/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">Blackpool</a>,
            <a href="/areas/web-design-accrington/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">Accrington</a> and
            <a href="/areas/web-design-lancaster/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">Lancaster</a>.
            For an overview of all our services, see our main <a href="/" class="text-blue-600 dark:text-blue-400 underline underline-offset-2">web design Lancashire</a> page.
          </p>
        </div>
      </div>

      <!-- Section 9: Deep-dive H2 & Pricing Anchor - What a Bespoke Website Costs -->
      <div class="space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Investment Guide
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            What a Bespoke Website Costs
          </h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Transparent pricing is central to how we operate. Typical projects start from £150 for focused landing pages and single-service setups, £300 to £600 for comprehensive multi-page corporate sites, and £800+ for complex portals and custom ecommerce builds.
          </p>
        </div>

        <PricingAnchor
          priceFrom={data.priceFrom}
          priceUnit="fixed project"
          whatsIncluded={data.whatsIncluded}
          title="Bespoke Projects from £150"
          subtitle="Fixed milestone pricing with zero hidden maintenance fees and full code ownership on delivery."
        />
      </div>

      <!-- Section 10: Client Testimonials & Reviews (USER REQUEST) -->
      <Testimonials
        heading="Client Reviews & Trust"
        subheading="Feedback from commercial directors and founders who partnered with Mohsin Ali for bespoke digital platforms."
      />

      <!-- Section 11: Founder Block -->
      <FounderBlock />

      <!-- Section 12: Local Coverage -->
      <LocalCoverage
        homeAnchor="Lancashire web design company"
        leadSentence="From our studio base in Blackburn, we deliver bespoke websites and digital platforms for ambitious businesses across the North West."
      />

      <!-- Section 13: FAQs -->
      <FAQ
        faqs={data.faqs}
        heading="Frequently Asked Questions"
        intro="Have questions about bespoke web development, pricing, or our code ownership guarantee? Here are straightforward answers."
      />

      <!-- Section 14: Related Services -->
      <RelatedServices
        services={relatedServicesList}
        heading="Explore Related Services"
        subheading="Complementary web engineering and digital marketing solutions for growing Lancashire firms."
      />

      <!-- Section 15: Inline Quote Form -->
      <div class="max-w-2xl mx-auto pt-8">
        <QuoteFormInline
          heading="Start Your Bespoke Website Project"
          subheading="Direct consultation with Mohsin Ali, founder and lead developer. Fixed-price proposals delivered in 24 hours."
          submitLabel="Get Your Bespoke Quote"
        />
      </div>

    </div>
  </article>
</ServiceLayout>
