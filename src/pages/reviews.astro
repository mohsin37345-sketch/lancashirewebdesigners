---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import CTABand from 'theme/components/CTABand.astro';
import Icon from 'theme/components/Icon.astro';
import { getCollection } from 'astro:content';

const title = 'Client Reviews & Feedback | Lancashire Web Designers';
const description = 'Read verified reviews from Lancashire and UK business owners. Uncompromised honesty, zero fabricated testimonials, and proven client satisfaction.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Reviews', url: '/reviews/' }
];

const allReviews = await getCollection('testimonials');
const verifiedReviews = allReviews.map(r => r.data).filter(r => r.verified === true);
---

<BaseLayout
  title={title}
  description={description}
  schemaType="article"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Client Reviews & Feedback
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Authentic commercial feedback from directors, marketing managers, and business owners who have partnered with our Lancashire studio.
        </p>
      </div>
    </div>
  </div>

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {verifiedReviews.length > 0 ? (
        <Testimonials testimonials={verifiedReviews} />
      ) : (
        <!-- Zero Fabrication Rule Authenticity Notice -->
        <div class="max-w-2xl mx-auto text-center space-y-6 py-12 px-6 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40">
          <div class="w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto">
            <Icon name="shield-check" class="w-6 h-6" />
          </div>
          <div class="space-y-2">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
              Authentic Reviews Only
            </h2>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-lg mx-auto">
              We strictly uphold Google and ASA transparency guidelines: we never publish fabricated case studies, stock photography portraits, or unverified star ratings. Every review published on our platform originates from a verified, contracted client project.
            </p>
          </div>
          <div class="pt-4 flex justify-center gap-4">
            <a
              href="/get-a-quote/"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-bold shadow-md transition-colors"
            >
              <span>Partner With Us</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      )}
    </div>
  </section>

  <CTABand
    heading="Experience the difference of working with senior engineers."
    subheading="Book a consultation today. Fixed-price proposals delivered within 24 hours."
    primaryCtaText="Get a Project Quote"
    primaryCtaHref="/get-a-quote/"
    secondaryCtaText="Explore Pricing"
    secondaryCtaHref="/pricing/"
  />
</BaseLayout>
