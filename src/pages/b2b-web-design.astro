---
import ServiceLayout from 'theme/layouts/ServiceLayout.astro';
import FeatureCards from 'theme/components/FeatureCards.astro';
import TechStack from 'theme/components/TechStack.astro';
import PortfolioShowcase from 'theme/components/PortfolioShowcase.astro';
import PricingAnchor from 'theme/components/PricingAnchor.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import FounderBlock from 'theme/components/FounderBlock.astro';
import LocalCoverage from 'theme/components/LocalCoverage.astro';
import FAQ from 'theme/components/FAQ.astro';
import RelatedServices from 'theme/components/RelatedServices.astro';
import QuoteFormInline from 'theme/components/QuoteFormInline.astro';
import Icon from 'theme/components/Icon.astro';
import { getEntry, getCollection } from 'astro:content';

const serviceEntry = await getEntry('services', 'b2b-web-design');
if (!serviceEntry) {
  throw new Error('Service entry b2b-web-design not found');
}
const data = serviceEntry.data;

const allProjects = await getCollection('portfolio');
const b2bProjects = allProjects
  .filter((p) => ['haul-uk-international', 'smart-rcm-billing', 'hvac-duct-calculator'].includes(p.id))
  .map((p) => ({
    title: p.data.title,
    client: p.data.client,
    industry: p.data.industry,
    href: `/portfolio/${p.data.slug || p.id}/`,
    brief: p.data.brief,
    metrics: p.data.metrics
  }));

const relatedServicesList = [
  {
    title: 'Bespoke Web Design',
    href: '/bespoke-web-design/',
    description: 'Hand-crafted digital platforms with zero template bloat and complete intellectual property ownership.',
    icon: 'palette'
  },
  {
    title: 'SEO Services',
    href: '/services/seo/',
    description: 'Technical SEO audits, content strategy, and Google ranking growth for commercial B2B terms.',
    icon: 'trending-up'
  },
  {
    title: 'Website Support & Care',
    href: '/website-support/',
    description: 'Proactive maintenance, security hardening, and dedicated developer hours without lock-in.',
    icon: 'shield-check'
  }
];

const heroTrustBullets = [
  'Buyer persona UX architecture',
  'CRM & automated sales pipeline integration',
  'Lead qualification funnels for commercial teams',
  'Direct communication with Mohsin Ali'
];
---

<ServiceLayout
  title={data.metaTitle}
  description={data.metaDescription}
  h1={data.heroHeading}
  heroSubheading={data.heroSubheading}
  heroEyebrow="B2B Web Design Agency • Commercial Growth"
  heroTrustBullets={heroTrustBullets}
  serviceType="B2B Web Design"
  priceFrom={data.priceFrom}
  faqs={data.faqs}
  faqIntro="Answers to common questions regarding B2B lead generation architecture, CRM integrations, and commercial timelines."
>
  <article class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Section 1: Intro (Primary keyword in first 100 words) -->
      <div class="max-w-4xl space-y-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          Commercial Lead Generation
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          A Strategic B2B Web Design Agency for Complex Buying Journeys
        </h2>
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
          As a specialised <strong>b2b web design agency</strong>, we recognise that business-to-business transactions are never simple impulse purchases. Your corporate website must satisfy diverse procurement stakeholders—from technical evaluators requiring exhaustive specification sheets to financial directors examining compliance, security, and proven return on investment.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
          Generic marketing sites focus merely on surface aesthetic trends. In contrast, our B2B website design architecture establishes deep domain authority, articulates distinct commercial value, and provides friction-free lead qualification pathways. We replace passive digital brochures with active commercial platforms designed to turn senior industry researchers into contracted enterprise clients.
        </p>
      </div>

      <!-- Section 2: Feature Cards (<p class="card-title"><strong>) -->
      <div class="space-y-6">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Engineered for Revenue
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Key Capabilities of Our B2B Architecture
          </h2>
        </div>
        <FeatureCards features={data.benefits} />
      </div>

      <!-- Section 3: Deep-dive H2 - How B2B Web Design Differs From Consumer Sites -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 p-8 sm:p-12 space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Strategic Distinction
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            How B2B Web Design Differs From Consumer Sites
          </h2>
          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            Consumer websites rely on emotional impulse, flash sales, and single-click checkouts. B2B transactions, by contrast, involve considered evaluations, committee sign-offs, and multi-week deliberation cycles. A procurement manager may review your compliance certifications, an engineering lead will evaluate technical specifications, and a managing director will scrutinise your commercial stability.
          </p>
          <p class="text-base text-slate-600 dark:text-slate-400 leading-relaxed">
            Our B2B website layouts are mapped to serve each decision-maker directly. We build clear technical documentation sections, interactive product configurators, case study proof libraries, and structured enquiry workflows that pre-qualify inbound enquiries before they reach your sales team.
          </p>
        </div>
      </div>

      <!-- Section 4: Deep-dive H2 - Industries We Work With -->
      <div class="space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Sector Expertise
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Industries We Work With Across Lancashire & the UK
          </h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            We partner with ambitious B2B businesses in sectors where clarity, speed, and trust directly impact the bottom line:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-3">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Manufacturing & Engineering</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Showcasing precision fabrication, CNC machinery, ISO accreditations, and engineering capabilities along the M65 corridor and nationwide.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-3">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Transport, Freight & Logistics</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Wholesale trade portals, fleet presentation, warehouse storage specifications, and automated commercial quote request funnels.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 space-y-3">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Professional Services & B2B Tech</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Consultancies, medical billing providers, software studios, and financial practices seeking high-authority digital presence.
            </p>
          </div>
        </div>

        <TechStack />
      </div>

      <!-- Section 5: Process (5-stage) -->
      <div class="space-y-8">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Pipeline Alignment
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Our B2B Platform Development Process
          </h2>
          <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm">
            Aligned with your sales cycle and marketing automation requirements.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.process.map((step) => (
            <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs space-y-3">
              <div class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400">Step {step.step}</div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 6: Inclusions / Boundaries -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="p-8 rounded-3xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/30 dark:bg-emerald-950/20 space-y-4">
          <h3 class="text-xl font-bold text-emerald-950 dark:text-emerald-300 flex items-center gap-2">
            <Icon name="check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            <span>Included in Every B2B Build</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-700 dark:text-slate-300">
            {data.whatsIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-4">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>Optional Scope Additions</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-400">
            {data.whatsNotIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-slate-400 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Section 7: Case Studies / Portfolio Showcase (USER REQUEST) -->
      <PortfolioShowcase
        heading="B2B Portfolio & Case Studies"
        subheading="Real commercial portals, billing systems, and trade platforms engineered for UK operators."
        items={b2bProjects}
      />

      <!-- Section 8: Deep-dive H2 - Lead Generation Architecture for Complex Sales Cycles -->
      <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-8 sm:p-12 space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Conversion Strategy
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Lead Generation Architecture for Complex Sales Cycles
          </h2>
          <p class="text-base text-slate-700 dark:text-slate-300 leading-relaxed">
            Capturing qualified commercial enquiries requires multi-tiered engagement points. Instead of forcing visitors into a single generic "Contact Us" form, we implement strategic conversion funnels: gated whitepapers, live product calculators, specification downloads, and executive consultation booking integrations.
          </p>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Every submission is programmatically connected to your sales pipeline via REST APIs or webhooks. Lead scores, referral origins, and campaign UTM parameters are preserved, enabling your sales reps to reach out with full contextual awareness.
          </p>
        </div>
      </div>

      <!-- Section 9: Deep-dive H2 & Pricing Anchor - What a B2B Website Investment Involves -->
      <div class="space-y-6">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Investment Overview
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            What a B2B Website Investment Involves
          </h2>
          <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Our B2B platform development starts from £250 for focused lead-generation pages, £400 to £800 for full corporate builds with CRM integrations, and tailored scoping for multi-tier trade portals with ERP connectivity.
          </p>
        </div>

        <PricingAnchor
          priceFrom={data.priceFrom}
          priceUnit="fixed project"
          whatsIncluded={data.whatsIncluded}
          title="B2B Platforms from £250"
          subtitle="Fixed milestone invoicing with zero recurring platform retainers and complete source code ownership."
        />
      </div>

      <!-- Section 10: Client Testimonials & Reviews (USER REQUEST) -->
      <Testimonials
        heading="Client Reviews & Trust"
        subheading="What B2B commercial directors and operations managers say about partnering with our Lancashire studio."
      />

      <!-- Section 11: Founder Block -->
      <FounderBlock />

      <!-- Section 12: Local Coverage -->
      <LocalCoverage
        homeAnchor="Lancashire B2B web design agency"
        leadSentence="From our base in Blackburn, we partner with B2B suppliers, manufacturers, and professional service firms across the North West."
      />

      <!-- Section 13: FAQs -->
      <FAQ
        faqs={data.faqs}
        heading="Frequently Asked Questions"
        intro="Have questions about B2B web development, CRM integrations, or project delivery? Here are transparent answers."
      />

      <!-- Section 14: Related Services -->
      <RelatedServices
        services={relatedServicesList}
        heading="Explore Related Services"
        subheading="Strategic digital capabilities engineered to support your commercial sales pipeline."
      />

      <!-- Section 15: Inline Quote Form -->
      <div class="max-w-2xl mx-auto pt-8">
        <QuoteFormInline
          heading="Start Your B2B Web Project"
          subheading="Direct consultation with Mohsin Ali, founder and lead developer. Fixed-price proposals delivered within 24 hours."
          submitLabel="Discuss Your B2B Project"
        />
      </div>

    </div>
  </article>
</ServiceLayout>
