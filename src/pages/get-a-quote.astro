---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import QuoteFormFull from 'theme/components/QuoteFormFull.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';

const title = 'Get a Bespoke Website Quote | Lancashire Web Designers';
const description = 'Request a fixed-price bespoke website quote. Complete our step-by-step project questionnaire for a senior developer review within 24 hours.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Get a Quote', url: '/get-a-quote/' }
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="contact"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Request a Fixed-Price Project Quote
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Tell us about your objectives, desired functionality, and target launch timeline. Our principal developer will review your brief and supply an itemised proposal within 24 hours.
        </p>
      </div>
    </div>
  </div>

  <TrustStrip />

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteFormFull />
    </div>
  </section>
</BaseLayout>
