---
import { getCollection, type CollectionEntry } from 'astro:content';
import PortfolioLayout from 'theme/layouts/PortfolioLayout.astro';
import TechStack from 'theme/components/TechStack.astro';
import CTABand from 'theme/components/CTABand.astro';

export async function getStaticPaths() {
  const portfolioEntries = await getCollection('portfolio');
  return portfolioEntries.map((entry) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry }
  }));
}

export interface Props {
  entry: CollectionEntry<'portfolio'>;
}

const { entry } = Astro.props;
if (!entry) {
  return Astro.redirect('/portfolio/');
}

const p = entry.data;
---

<PortfolioLayout
  title={`${p.title} | Case Study | Lancashire Web Designers`}
  description={p.brief.slice(0, 150)}
  client={p.client}
  industry={p.industry}
  year={p.year}
  services={p.services}
  techStack={p.techStack}
  metrics={p.metrics}
  liveUrl={p.liveUrl}
  heroImage={p.images?.[0]?.src}
>
  <div class="py-12 lg:py-16 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {/* Visual Showcase: Project Screenshots */}
      {p.images && p.images.length > 0 && (
        <div class="space-y-8">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">
              Project Visuals & Implementation
            </h2>
            {p.liveUrl && (
              <a
                href={p.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 hover:bg-blue-100 rounded-lg transition-colors"
              >
                <span>Visit Live Platform</span>
                <span>&nearr;</span>
              </a>
            )}
          </div>

          <div class="grid grid-cols-1 gap-8">
            {p.images.map((img) => (
              <figure class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-md bg-slate-50 dark:bg-slate-800/50">
                <img
                  src={img.src}
                  alt={img.alt}
                  class="w-full h-auto object-cover max-h-[720px]"
                  loading="eager"
                  decoding="async"
                />
                {img.caption && (
                  <figcaption class="p-4 text-xs font-medium text-slate-600 dark:text-slate-400 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                    <span>{img.caption}</span>
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      )}

      {/* Case Study Narrative */}
      <div class="max-w-3xl space-y-10">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Project Brief</h2>
          <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">{p.brief}</p>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Our Engineering Approach</h2>
          <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">{p.approach}</p>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Commercial Outcome</h2>
          <p class="mt-3 text-base text-slate-600 dark:text-slate-300 leading-relaxed">{p.outcome}</p>
        </div>
      </div>

      <TechStack />
    </div>
  </div>

  <CTABand
    heading="Inspired by this project outcome?"
    subheading="Speak directly with our senior engineer to achieve similar results for your business."
    primaryCtaText="Get a Project Quote"
    primaryCtaHref="/get-a-quote/"
  />
</PortfolioLayout>
