---
import ServiceLayout from 'theme/layouts/ServiceLayout.astro';
import TechStack from 'theme/components/TechStack.astro';
import FAQ from 'theme/components/FAQ.astro';
import QuoteFormInline from 'theme/components/QuoteFormInline.astro';
import Icon from 'theme/components/Icon.astro';
import { getEntry } from 'astro:content';

const serviceEntry = await getEntry('services', 'website-support');
if (!serviceEntry) {
  throw new Error('Service entry website-support not found');
}
const data = serviceEntry.data;
---

<ServiceLayout
  title={data.metaTitle}
  description={data.metaDescription}
  h1={data.heroHeading}
  heroSubheading={data.heroSubheading}
  serviceType="Website Support & Maintenance"
  priceFrom={data.priceFrom}
  faqs={data.faqs}
>
  <article class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- Section 1: In-depth Summary -->
      <div class="max-w-4xl space-y-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          Proactive Technical Care
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          A Dedicated Web Support Agency Protecting Your Digital Investment
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Operating as a proactive <strong>web support agency</strong>, Lancashire Web Designers provides comprehensive technical maintenance, continuous security hardening, and on-demand developer support. Leaving your corporate website unmanaged exposes your firm to malware injection, catastrophic plugin conflicts, broken customer checkout flows, and severe Google ranking penalties.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          Our managed website care plans protect your operations with automated 24/7 uptime monitoring, daily off-site European cloud backups, safe staging testing for all updates, and dedicated developer hours each month for your ongoing content edits and feature enhancements.
        </p>
      </div>

      <!-- Section 2: Care Plan Tiers -->
      <div class="space-y-8">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Care Packages
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Monthly Website Support Plans
          </h2>
          <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm">
            No long-term contracts. Rolling 30-day agreements tailored to your platform scale.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs space-y-4">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Essential Care</h3>
            <div class="text-3xl font-black text-slate-900 dark:text-white">£99<span class="text-xs text-slate-400 font-normal">/mo + VAT</span></div>
            <p class="text-xs text-slate-500 dark:text-slate-400">Ideal for standard commercial brochure websites.</p>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300 pt-2 border-t border-slate-100 dark:border-slate-800">
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Daily off-site cloud backups</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> 24/7 uptime monitoring</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Monthly staging security updates</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> 30 mins included dev tasks</li>
            </ul>
          </div>

          <div class="p-6 rounded-2xl border-2 border-blue-600 bg-white dark:bg-slate-900 shadow-lg relative space-y-4">
            <div class="absolute -top-3 left-6 bg-blue-600 text-white text-[10px] font-bold uppercase tracking-wider py-0.5 px-2.5 rounded-full">Recommended</div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Professional Growth</h3>
            <div class="text-3xl font-black text-slate-900 dark:text-white">£175<span class="text-xs text-slate-400 font-normal">/mo + VAT</span></div>
            <p class="text-xs text-slate-500 dark:text-slate-400">For active B2B firms requiring ongoing content updates.</p>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300 pt-2 border-t border-slate-100 dark:border-slate-800">
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Everything in Essential</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> 2 hours included developer time</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Priority 4-hour emergency SLA</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Monthly Core Web Vitals speed tune</li>
            </ul>
          </div>

          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs space-y-4">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Ecommerce & Enterprise</h3>
            <div class="text-3xl font-black text-slate-900 dark:text-white">£295<span class="text-xs text-slate-400 font-normal">/mo + VAT</span></div>
            <p class="text-xs text-slate-500 dark:text-slate-400">For transactional online stores and high-traffic portals.</p>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300 pt-2 border-t border-slate-100 dark:border-slate-800">
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Real-time hourly transactional backups</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> 4 hours included developer time</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> 1-hour critical emergency response</li>
              <li class="flex items-center gap-2"><Icon name="check" class="w-3.5 h-3.5 text-blue-600" /> Checkout flow & payment auditing</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Section 3: Key Benefits Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {data.benefits.map((benefit) => (
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center">
              <Icon name="shield-check" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Reliability Protection</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{benefit}</p>
          </div>
        ))}
      </div>

      <!-- Section 4: 5-Stage Process -->
      <div class="space-y-8">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
            Rapid Onboarding
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
            Our Onboarding & Support Workflow
          </h2>
          <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm">
            We onboard your existing website within 24 to 48 hours.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {data.process.map((step) => (
            <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xs space-y-3">
              <div class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400">Step {step.step}</div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Section 5: Inclusions / Boundaries -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="p-8 rounded-3xl border border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/30 dark:bg-emerald-950/20 space-y-4">
          <h3 class="text-xl font-bold text-emerald-950 dark:text-emerald-300 flex items-center gap-2">
            <Icon name="check" class="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            <span>Standard Support Deliverables</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-700 dark:text-slate-300">
            {data.whatsIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50 space-y-4">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>Items Quoted Separately</span>
          </h3>
          <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-400">
            {data.whatsNotIncluded.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-slate-400 font-bold">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Section 6: TechStack -->
      <TechStack />

      <!-- Section 7: FAQs -->
      <FAQ faqs={data.faqs} />

      <!-- Section 8: Inline Quote Form -->
      <div class="max-w-2xl mx-auto pt-8">
        <QuoteFormInline
          heading="Enquire About a Website Care Plan"
          subheading="Tell us your current website platform and we will confirm onboarding details within 24 hours."
        />
      </div>
    </div>
  </article>
</ServiceLayout>
