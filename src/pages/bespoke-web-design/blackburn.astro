---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import FAQ from 'theme/components/FAQ.astro';
import QuoteFormInline from 'theme/components/QuoteFormInline.astro';
import CTABand from 'theme/components/CTABand.astro';
import ComparisonTable from 'theme/components/ComparisonTable.astro';
import { getEntry } from 'astro:content';

const saEntry = await getEntry('serviceAreas', 'bespoke-web-design-blackburn');
if (!saEntry) {
  throw new Error('ServiceArea entry bespoke-web-design-blackburn not found');
}
const data = saEntry.data;

const title = 'Bespoke Web Design Blackburn | Lancashire Web Designers';
const description = 'Bespoke web design for Blackburn manufacturers, logistics firms, and commercial services. Hand-crafted code, sub-second speeds, and zero template bloat.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Bespoke Web Design', url: '/bespoke-web-design/' },
  { name: 'Blackburn', url: '/bespoke-web-design/blackburn/' }
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="service"
  breadcrumbs={breadcrumbs}
  faqs={data.faqs}
>
  <!-- Interactive Modern Hero Section with Quote Form & Floating SVG Tech Badges -->
  <Hero
    variant="location"
    heading="Bespoke Web Design in Blackburn"
    subheading="High-performance digital engineering crafted specifically for East Lancashire manufacturers, logistics operators, and commercial services along the M65 corridor."
    breadcrumbs={breadcrumbs}
    badge="Blackburn Web Engineering • No Templates"
    primaryCtaText="Get a Bespoke Quote"
    primaryCtaHref="/get-a-quote/"
    secondaryCtaText="Explore Pricing"
    secondaryCtaHref="/pricing/"
  />

  <article class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="max-w-4xl space-y-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
          Tailored Architecture
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Why Blackburn Companies Require Custom Web Software
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          {data.uniqueIntro}
        </p>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          {data.localAngle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 space-y-3">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">Industrial & Commercial Focus</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Engineered specifically for Blackburn manufacturers, trade contractors, and logistics companies seeking high-value commercial contracts.</p>
        </div>
        <div class="p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 space-y-3">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">Sub-Second Page Speeds</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Built with modern static generation and zero template bloat, achieving 100/100 Google Lighthouse scores on desktop and mobile.</p>
        </div>
        <div class="p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 space-y-3">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">Direct Developer Access</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">Collaborate directly with senior UK software engineers based in Lancashire, with rapid local turnaround and ongoing care.</p>
        </div>
      </div>
    </div>
  </article>

  <ComparisonTable />

  <section class="py-16 lg:py-24 bg-slate-50 dark:bg-slate-900/40 border-t border-slate-200 dark:border-slate-800/80">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Blackburn Web Design FAQs
        </h2>
      </div>
      <FAQ faqs={data.faqs} />
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteFormInline
        heading="Start Your Blackburn Project"
        subheading="Tell us about your requirements. We'll respond with a transparent, fixed-price proposal within 24 hours."
      />
    </div>
  </section>

  <CTABand
    heading="Ready to upgrade your Blackburn business website?"
    subheading="Speak with our senior developers directly. Zero templates, zero sales pressure."
  />
</BaseLayout>
