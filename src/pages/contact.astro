---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import Icon from 'theme/components/Icon.astro';
import { site } from 'src/data/site';

const title = 'Contact Us | Lancashire Web Designers';
const description = 'Get in touch with Lancashire Web Designers. Request a fixed-price bespoke website quote or speak directly with our principal technical architect.';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' }
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="contact"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800/80 py-12 lg:py-16">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
          Let&rsquo;s Discuss Your Web Project
        </h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Speak directly with our senior development team. We review every brief thoroughly and reply with clear architectural guidance and fixed-price estimates within 24 hours.
        </p>
      </div>
    </div>
  </div>

  <section class="py-16 lg:py-24 bg-white dark:bg-slate-900">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left: Studio Details & Value Props -->
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-4">
            <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400">
              Direct Communication
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
              No Sales Reps, No Agency Gatekeepers
            </h2>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              When you contact Lancashire Web Designers, your enquiry is reviewed by the senior technical specialist who will actually design and build your platform. We answer technical questions honestly and provide transparent, itemised costings upfront.
            </p>
          </div>

          <!-- Studio Service Info Cards -->
          <div class="space-y-4">
            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                <Icon name="clock" class="w-5 h-5" />
              </div>
              <div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">Rapid Response SLA</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">We respond to all verified project enquiries within 24 business hours.</div>
              </div>
            </div>

            <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                <Icon name="map-pin" class="w-5 h-5" />
              </div>
              <div>
                <div class="text-sm font-bold text-slate-900 dark:text-white">Regional Lancashire Coverage</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Based in Blackburn, meeting clients across Preston, Lancaster, Ribble Valley, and the UK.</div>
              </div>
            </div>

            <!-- Conditionally render contact info if configured in site.ts -->
            {site.email && (
              <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                  <Icon name="mail" class="w-5 h-5" />
                </div>
                <div>
                  <div class="text-sm font-bold text-slate-900 dark:text-white">Direct Email</div>
                  <a href={`mailto:${site.email}`} class="text-xs text-blue-600 dark:text-blue-400 hover:underline mt-0.5 block font-semibold">
                    {site.email}
                  </a>
                </div>
              </div>
            )}

            {site.phone && (
              <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                  <Icon name="phone" class="w-5 h-5" />
                </div>
                <div>
                  <div class="text-sm font-bold text-slate-900 dark:text-white">Telephone Consultation</div>
                  <a href={`tel:${site.phone}`} class="text-xs text-blue-600 dark:text-blue-400 hover:underline mt-0.5 block font-semibold">
                    {site.phone}
                  </a>
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Right: Primary Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
